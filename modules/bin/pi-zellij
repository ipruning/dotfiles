#!/usr/bin/env bash

set -euo pipefail
if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
  echo 'Usage: pi-zellij'
  echo 'Create or attach to a Pi Zellij session for the current directory (requires git, zellij, and its pi layout).'
  exit 0
fi
if (( $# != 0 )); then
  echo 'pi-zellij: no arguments accepted; use --help' >&2
  exit 2
fi

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/_lib/session-id.sh"

pwd_abs="$(pwd -P)"
session="$(session_id_for_dir "$pwd_abs")"
layout="pi"

set +e
sessions="$(zellij list-sessions --no-formatting --short 2>&1)"
list_status=$?
set -e

if (( list_status == 0 )); then
  if ! grep -Fxq "$session" <<<"$sessions"; then
    zellij --session "$session" --new-session-with-layout "$layout"
    exit 0
  fi
elif (( list_status == 1 )) && [[ "$sessions" == *"No active zellij sessions found."* ]]; then
  zellij --session "$session" --new-session-with-layout "$layout"
  exit 0
else
  printf '%s\n' "$sessions" >&2
  exit "$list_status"
fi

exec zellij attach "$session"
