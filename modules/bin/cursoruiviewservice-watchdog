#!/usr/bin/env bash

set -euo pipefail
if (( $# > 1 )) || [[ -z "${1-CursorUIViewService}" ]]; then
  echo "Usage: cursoruiviewservice-watchdog [PROCESS_NAME]" >&2
  exit 2
fi
APP="${1:-CursorUIViewService}"
OSASCRIPT="${WATCHDOG_OSASCRIPT:-/usr/bin/osascript}"
PGREP="${WATCHDOG_PGREP:-/usr/bin/pgrep}"

set +e
ax_result=$("$OSASCRIPT" - "$APP" <<'AS'
on run argv
  set pname to item 1 of argv
  tell application "System Events"
    if not (exists process pname) then return "not-running"
  end tell
  try
    with timeout of 1 seconds
      tell application "System Events"
        set _ to value of attribute "AXFocusedUIElement" of process pname
      end tell
    end timeout
    return "ok"
  on error errMsg number errNum
    if errNum is -1712 then
      return "timeout"
    else
      return "error:" & errNum & ":" & errMsg
    end if
  end try
end run
AS
)
probe_status=$?
pids=$("$PGREP" -x "$APP")
pgrep_status=$?
set -e

printf 'process=%s\nax_probe=%s\npids=%s\n' "$APP" "${ax_result:-error:empty-result}" "${pids//$'\n'/,}"

if (( probe_status != 0 )) || (( pgrep_status > 1 )) || \
    [[ "$ax_result" != "ok" && "$ax_result" != "not-running" ]]; then
  echo "cursoruiviewservice-watchdog: read-only probe is abnormal; inspect the listed PIDs and restart the owning application if appropriate" >&2
  exit 1
fi
