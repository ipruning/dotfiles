#!/usr/bin/env bash

set -euo pipefail
if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
  echo 'Usage: dateutc'
  echo 'Print the current UTC time in ISO 8601 format.'
  exit 0
fi
if (( $# != 0 )); then
  echo 'dateutc: no arguments accepted; use --help' >&2
  exit 2
fi
exec date -u +%Y-%m-%dT%H:%M:%SZ
