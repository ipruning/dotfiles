#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tiktoken==0.13.0"]
# ///
"""Print the o200k_base token count for text or files."""

from __future__ import annotations

import sys
from pathlib import Path
from urllib.parse import unquote, urlparse

import tiktoken

MAX_CLIPBOARD_PATHS = 100


def count_request(args: list[str], stdin_text: str, base_dir: Path) -> int:
    encoding = tiktoken.get_encoding("o200k_base")

    def resolve(raw: str) -> Path:
        if raw.startswith("file://"):
            return Path(unquote(urlparse(raw).path))
        path = Path(raw).expanduser()
        return path if path.is_absolute() else base_dir / path

    if args:
        paths = [resolve(arg) for arg in args]
        if all(path.is_file() for path in paths):
            return sum(
                len(encoding.encode(path.read_text(errors="replace"), disallowed_special=()))
                for path in paths
            )
        text = " ".join(args)
    else:
        text = stdin_text
        lines = [line.strip() for line in text.strip().splitlines() if line.strip()]
        paths = [resolve(line) for line in lines]
        if lines and len(lines) <= MAX_CLIPBOARD_PATHS and all(
            path.is_file() for path in paths
        ):
            return sum(
                len(encoding.encode(path.read_text(errors="replace"), disallowed_special=()))
                for path in paths
            )
    return len(encoding.encode(text, disallowed_special=()))


def main() -> int:
    args = sys.argv[1:]
    if not args and sys.stdin.isatty():
        print(__doc__, file=sys.stderr)
        print("Usage: ttok TEXT | ttok FILE... | command | ttok", file=sys.stderr)
        return 1
    stdin_text = sys.stdin.read() if not args else ""
    print(count_request(args, stdin_text, Path.cwd()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
