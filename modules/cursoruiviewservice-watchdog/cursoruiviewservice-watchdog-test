#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cli="$script_dir/cursoruiviewservice-watchdog"
test_root="$(mktemp -d -t cursoruiviewservice-watchdog-test)"
fake_bin="$test_root/fake-bin"
state="$test_root/fake-state"
expected_executable='/System/Library/PrivateFrameworks/TextInputUIMacHelper.framework/Versions/A/XPCServices/CursorUIViewService.xpc/Contents/MacOS/CursorUIViewService'

cleanup() { rm -rf "$test_root"; }
trap cleanup EXIT
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

mkdir -p "$fake_bin" "$state"
printf '123\n' >"$state/service-pid"
printf '%s\n' "$((5 * 1024 * 1024 * 1024))" >"$state/footprint"
printf '%s\n' "$((4 * 1024 * 1024 * 1024))" >"$state/swapped"
: >"$state/service-running"

cat >"$fake_bin/uname" <<'EOF'
#!/bin/bash
echo Darwin
EOF

cat >"$fake_bin/ps" <<'EOF'
#!/bin/bash
pid=""
while (( $# )); do
  if [[ "$1" == -p ]]; then
    pid="$2"
    break
  fi
  shift
done
if [[ -e "$FAKE_STATE/old-process-gone" && "$pid" == "$(cat "$FAKE_STATE/service-pid")" ]]; then
  exit 1
fi
if [[ -e "$FAKE_STATE/bad-process-path" ]]; then
  echo /tmp/not-the-apple-service
else
  echo "$EXPECTED_EXECUTABLE"
fi
EOF

cat >"$fake_bin/footprint" <<'EOF'
#!/bin/bash
pid="" destination=""
while (( $# )); do
  case "$1" in
    --pid) pid="$2"; shift 2 ;;
    --json) destination="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[[ -n "$pid" && -n "$destination" ]] || exit 2
if [[ -e "$FAKE_STATE/fail-footprint" ]]; then
  echo 'injected footprint failure' >&2
  exit 9
fi
footprint="$(cat "$FAKE_STATE/footprint")"
swapped="$(cat "$FAKE_STATE/swapped")"
cat >"$destination" <<JSON
{"processes":[{"pid":$pid,"auxiliary":{"phys_footprint":$footprint}}],"summary":{"total":{"swapped":$swapped}},"errors":[]}
JSON
if [[ -e "$FAKE_STATE/replace-after-footprint" ]]; then
  rm "$FAKE_STATE/replace-after-footprint"
  old_pid="$(cat "$FAKE_STATE/service-pid")"
  printf '%s\n' "$((old_pid + 1))" >"$FAKE_STATE/service-pid"
fi
EOF

cat >"$fake_bin/launchctl" <<'EOF'
#!/bin/bash
case "${1:-}" in
  print)
    if [[ "$2" == user/*/com.apple.TextInputUI.xpc.CursorUIViewService ]]; then
      if [[ -e "$FAKE_STATE/old-process-gone" && -e "$FAKE_STATE/stale-read" ]]; then
        mv "$FAKE_STATE/pending-service-pid" "$FAKE_STATE/service-pid"
        rm -f "$FAKE_STATE/old-process-gone" "$FAKE_STATE/stale-read"
      elif [[ -e "$FAKE_STATE/old-process-gone" ]]; then
        : >"$FAKE_STATE/stale-read"
      fi
      if [[ -e "$FAKE_STATE/service-running" ]]; then
        printf '\tstate = running\n\tpid = %s\n' "$(cat "$FAKE_STATE/service-pid")"
      else
        printf '\tstate = not running\n'
      fi
      exit 0
    fi
    [[ -e "$FAKE_STATE/agent-loaded" ]]
    ;;
  bootout)
    rm -f "$FAKE_STATE/agent-loaded"
    ;;
  bootstrap)
    if [[ -e "$FAKE_STATE/fail-bootstrap" ]]; then
      echo 'injected bootstrap failure' >&2
      exit 8
    fi
    : >"$FAKE_STATE/agent-loaded"
    ;;
  *) exit 2 ;;
esac
EOF

cat >"$fake_bin/kill" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >>"$FAKE_STATE/kill-calls"
if [[ -e "$FAKE_STATE/fail-kill" ]]; then
  echo 'injected kill failure' >&2
  exit 7
fi
[[ "$1" == -KILL && "$2" == "$(cat "$FAKE_STATE/service-pid")" ]] || exit 2
old_pid="$(cat "$FAKE_STATE/service-pid")"
if [[ -e "$FAKE_STATE/stale-after-kill" ]]; then
  printf '%s\n' "$((old_pid + 1))" >"$FAKE_STATE/pending-service-pid"
  : >"$FAKE_STATE/old-process-gone"
  rm -f "$FAKE_STATE/stale-after-kill"
else
  printf '%s\n' "$((old_pid + 1))" >"$FAKE_STATE/service-pid"
fi
printf '%s\n' "$((128 * 1024 * 1024))" >"$FAKE_STATE/footprint"
EOF

cat >"$fake_bin/osascript" <<'EOF'
#!/bin/bash
printf '%s\n' "${*: -1}" >>"$FAKE_STATE/probe-calls"
if [[ -e "$FAKE_STATE/probe-result" ]]; then
  cat "$FAKE_STATE/probe-result"
else
  echo responsive
fi
EOF
chmod +x "$fake_bin"/*

test_env=(
  CURSORUIVIEW_WATCHDOG_TEST_ROOT="$test_root"
  CURSORUIVIEW_WATCHDOG_LAUNCHCTL_BIN="$fake_bin/launchctl"
  CURSORUIVIEW_WATCHDOG_FOOTPRINT_BIN="$fake_bin/footprint"
  CURSORUIVIEW_WATCHDOG_PS_BIN="$fake_bin/ps"
  CURSORUIVIEW_WATCHDOG_KILL_BIN="$fake_bin/kill"
  CURSORUIVIEW_WATCHDOG_OSASCRIPT_BIN="$fake_bin/osascript"
  CURSORUIVIEW_WATCHDOG_UNAME_BIN="$fake_bin/uname"
  FAKE_STATE="$state"
  EXPECTED_EXECUTABLE="$expected_executable"
)
home="$test_root/home"
installed_bin="$home/.local/bin/cursoruiviewservice-watchdog"
runtime="$home/Library/Application Support/cursoruiviewservice-watchdog/cursoruiviewservice-watchdog"
state_file="$home/Library/Application Support/cursoruiviewservice-watchdog/state.json"
plist="$home/Library/LaunchAgents/com.ipruning.cursoruiviewservice-watchdog.plist"

env "${test_env[@]}" "$cli" install --json >"$test_root/install-preview.json"
mise exec -- jq -e '
  .schema_version == 1 and .operation == "install" and .ok == true and
  .apply == false and .auto_recycle == false and .interval_seconds == 30 and
  .threshold_bytes == 536870912 and
  .early_recycle_threshold_bytes == 402653184 and
  .required_unresponsive_samples == 3
' "$test_root/install-preview.json" >/dev/null || fail 'install preview contract is invalid'
[[ ! -e "$installed_bin" && ! -e "$runtime" && ! -e "$plist" && ! -e "$state/agent-loaded" ]] \
  || fail 'install preview mutated installation state'

env "${test_env[@]}" "$cli" recycle --json >"$test_root/uninstalled-recycle-preview.json"
[[ ! -e "$home" ]] || fail 'recycle preview created runtime state'

env "${test_env[@]}" "$cli" install --apply --json >"$test_root/install-monitor.json"
plutil -extract ProgramArguments json -o - "$plist" | mise exec -- jq -e '
  .[-2:] == ["run", "--json"] and (contains(["--apply"]) | not)
' >/dev/null || fail 'default installation is not monitor-only'

env "${test_env[@]}" "$cli" install --auto-recycle --apply --json >"$test_root/install.json"
[[ -x "$installed_bin" && -x "$runtime" && -f "$plist" && -e "$state/agent-loaded" ]] \
  || fail 'install did not complete the user LaunchAgent lifecycle'
[[ "$(plutil -extract StartInterval raw -o - "$plist")" == 30 ]] \
  || fail 'LaunchAgent interval is wrong'
[[ "$(plutil -extract ProcessType raw -o - "$plist")" == Background ]] \
  || fail 'LaunchAgent is not background-classified'
if plutil -extract KeepAlive raw -o - "$plist" >/dev/null 2>&1; then
  fail 'LaunchAgent incorrectly keeps a resident watchdog alive'
fi
plutil -extract ProgramArguments json -o - "$plist" | mise exec -- jq -e '
  .[-3:] == ["run", "--apply", "--json"]
' >/dev/null || fail 'LaunchAgent does not invoke the guarded run command'

env "${test_env[@]}" "$cli" status --json >"$test_root/status.json"
mise exec -- jq -e '
  .schema_version == 1 and .operation == "status" and .ok == true and
  .installed == true and .loaded == true and .service_available == true and
  .auto_recycle == true and .interval_seconds == 30 and
  .cooldown_seconds == 300 and
  .threshold_bytes == 536870912 and
  .early_recycle_threshold_bytes == 402653184 and
  .required_unresponsive_samples == 3 and
  (has("minimum_idle_seconds") | not)
' "$test_root/status.json" >/dev/null || fail 'installed status is invalid'

exit_code=0
env "${test_env[@]}" "$cli" check --json >"$test_root/check-high.json" || exit_code=$?
[[ "$exit_code" == 1 && ! -e "$state_file" ]] \
  || fail 'read-only high-footprint check mutated state or returned the wrong status'
mise exec -- jq -e '
  .operation == "check" and .ok == true and .high == true and
  .footprint_bytes == 5368709120 and .swapped_bytes == 4294967296 and
  .early_high == true and .responsiveness == "responsive" and
  .unresponsive == false and (has("idle_seconds") | not)
' "$test_root/check-high.json" >/dev/null || fail 'check did not report measured footprint'

env "${test_env[@]}" "$cli" run --json >"$test_root/run-preview.json"
mise exec -- jq -e '.apply == false and .result == "preview" and .high == true' \
  "$test_root/run-preview.json" >/dev/null || fail 'automatic run did not preview by default'
[[ ! -e "$state_file" && ! -e "$state/kill-calls" ]] \
  || fail 'automatic preview mutated watchdog state'

printf '%s\n' "$((400 * 1024 * 1024))" >"$state/footprint"
printf '%s\n' 'error:-1743:not authorized' >"$state/probe-result"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-probe-error.json"
mise exec -- jq -e '
  .result == "deferred-probe-error" and .early_high == true and
  .high == false and .responsiveness == "error" and
  .unresponsive_streak == 0 and (.probe_error | contains("-1743"))
' "$test_root/run-probe-error.json" >/dev/null \
  || fail 'responsiveness probe error was not safely deferred'
[[ ! -e "$state/kill-calls" ]] || fail 'responsiveness probe error signaled the service'

printf '%s\n' responsive >"$state/probe-result"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-early-responsive.json"
mise exec -- jq -e '
  .result == "healthy" and .early_high == true and .high == false and
  .responsiveness == "responsive" and .unresponsive_streak == 0
' "$test_root/run-early-responsive.json" >/dev/null \
  || fail 'responsive service above the early threshold was not retained'
[[ ! -e "$state/kill-calls" ]] || fail 'responsive service was signaled'

printf '%s\n' timeout >"$state/probe-result"
exit_code=0
env "${test_env[@]}" "$cli" check --json >"$test_root/check-unresponsive.json" || exit_code=$?
[[ "$exit_code" == 1 ]] || fail 'read-only timeout check returned success'
mise exec -- jq -e '
  .high == false and .early_high == true and .responsiveness == "timeout" and
  .unresponsive == true
' "$test_root/check-unresponsive.json" >/dev/null \
  || fail 'read-only check did not report the responsiveness timeout'

env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-timeout-1.json"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-timeout-2.json"
mise exec -- jq -e '
  .result == "deferred-unresponsive-streak" and .responsiveness == "timeout" and
  .unresponsive_streak == 1
' "$test_root/run-timeout-1.json" >/dev/null || fail 'first timeout was not deferred'
mise exec -- jq -e '
  .result == "deferred-unresponsive-streak" and .responsiveness == "timeout" and
  .unresponsive_streak == 2
' "$test_root/run-timeout-2.json" >/dev/null || fail 'second timeout was not deferred'
[[ ! -e "$state/kill-calls" ]] || fail 'fewer than three timeouts signaled the service'

env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-timeout-3.json"
mise exec -- jq -e '
  .result == "recycled" and .recycle_reason == "unresponsive" and
  .responsiveness == "timeout" and .unresponsive_streak == 3 and
  .old_pid == 123 and .new_pid == 124 and .new_footprint_bytes == 134217728
' "$test_root/run-timeout-3.json" >/dev/null \
  || fail 'three confirmed timeouts did not recycle the early-high service'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 1 ]] \
  || fail 'unresponsive recycle did not send exactly one signal'
mise exec -- jq -e '
  .last_recycle_reason == "unresponsive" and .last_probe_result == "timeout" and
  .unresponsive_pid == null and .unresponsive_streak == 0
' "$state_file" >/dev/null || fail 'unresponsive recycle state was not finalized'

rm -f "$state_file" "$state/kill-calls" "$state/probe-calls" "$state/probe-result"
printf '%s\n' 123 >"$state/service-pid"
printf '%s\n' "$((5 * 1024 * 1024 * 1024))" >"$state/footprint"
: >"$state/stale-after-kill"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-aggressive.json"
mise exec -- jq -e '
  .result == "recycled" and .old_pid == 123 and .new_pid == 124 and
  .new_footprint_bytes == 134217728 and .recycle_reason == "hard-threshold" and
  .responsiveness == "not-required" and (has("high_streak") | not)
' "$test_root/run-aggressive.json" >/dev/null \
  || fail 'first high sample was not recycled across stale launchd state'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 1 ]] \
  || fail 'aggressive recycle did not send exactly one signal'
rg -q '^-KILL 123$' "$state/kill-calls" \
  || fail 'aggressive recycle did not signal the verified PID'

rm -f "$state_file"
printf '%s\n' "$((5 * 1024 * 1024 * 1024))" >"$state/footprint"
: >"$state/replace-after-footprint"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-race.json"
mise exec -- jq -e '
  .result == "deferred-service-changed" and .current_pid == 125 and
  (has("high_streak") | not)
' "$test_root/run-race.json" >/dev/null || fail 'service replacement race was not deferred'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 1 ]] \
  || fail 'service replacement race signaled a changed PID'

env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-recycled.json"
mise exec -- jq -e '
  .result == "recycled" and .old_pid == 125 and .new_pid == 126 and
  .new_footprint_bytes == 134217728 and (has("high_streak") | not)
' "$test_root/run-recycled.json" >/dev/null || fail 'guarded recycle was not verified'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 2 ]] \
  || fail 'verified recycle did not send exactly one additional signal'
rg -q '^-KILL 125$' "$state/kill-calls" \
  || fail 'recycle did not signal the launchd-verified PID'

printf '%s\n' "$((5 * 1024 * 1024 * 1024))" >"$state/footprint"
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/run-cooldown.json"
mise exec -- jq -e '.result == "deferred-cooldown" and .cooldown_remaining_seconds > 0' \
  "$test_root/run-cooldown.json" >/dev/null || fail 'cooldown did not suppress repeat recycling'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 2 ]] \
  || fail 'cooldown allowed a repeat signal'

env "${test_env[@]}" "$cli" recycle --json >"$test_root/recycle-preview.json"
mise exec -- jq -e '
  .operation == "recycle" and .apply == false and .result == "preview" and
  .action == "kill -KILL"
' "$test_root/recycle-preview.json" >/dev/null || fail 'manual recycle did not preview by default'
[[ "$(wc -l <"$state/kill-calls" | tr -d ' ')" == 2 ]] \
  || fail 'manual preview changed the service'

env "${test_env[@]}" "$cli" recycle --apply --json >"$test_root/recycle-applied.json"
mise exec -- jq -e '.apply == true and .result == "recycled" and .new_pid == 127' \
  "$test_root/recycle-applied.json" >/dev/null || fail 'explicit manual recycle was not verified'

rm -f "$state_file"
printf '%s\n' "$((5 * 1024 * 1024 * 1024))" >"$state/footprint"
: >"$state/fail-kill"
exit_code=0
env "${test_env[@]}" "$cli" run --apply --json >"$test_root/recycle-failed.json" || exit_code=$?
[[ "$exit_code" == 1 ]] || fail 'kill failure returned success'
mise exec -- jq -e '
  .operation == "run" and .ok == false and .apply == true and
  (.error | contains("injected kill failure"))
' "$test_root/recycle-failed.json" >/dev/null || fail 'kill failure lost its JSON error contract'
rm -f "$state/fail-kill"

: >"$state/bad-process-path"
exit_code=0
env "${test_env[@]}" "$cli" check --json >"$test_root/bad-identity.json" || exit_code=$?
[[ "$exit_code" == 1 ]] || fail 'unexpected executable identity returned success'
mise exec -- jq -e '.ok == false and (.error | contains("unexpected executable"))' \
  "$test_root/bad-identity.json" >/dev/null || fail 'identity failure was not diagnosed'
rm -f "$state/bad-process-path"

rm -f "$state/service-running"
env "${test_env[@]}" "$cli" check --json >"$test_root/not-running.json"
mise exec -- jq -e '.ok == true and .running == false and .high == false' \
  "$test_root/not-running.json" >/dev/null || fail 'on-demand stopped state was treated as unhealthy'
: >"$state/service-running"

env "${test_env[@]}" "$cli" uninstall --json >"$test_root/uninstall-preview.json"
mise exec -- jq -e '.apply == false and .result == "preview" and .loaded == true' \
  "$test_root/uninstall-preview.json" >/dev/null || fail 'uninstall did not preview by default'
[[ -x "$installed_bin" && -x "$runtime" && -f "$plist" && -e "$state/agent-loaded" ]] \
  || fail 'uninstall preview changed installation state'

env "${test_env[@]}" "$cli" uninstall --apply --json >"$test_root/uninstall.json"
[[ ! -e "$installed_bin" && ! -e "$runtime" && ! -e "$plist" && ! -e "$state/agent-loaded" ]] \
  || fail 'uninstall left managed installation state'
[[ -f "$state_file" ]] || fail 'uninstall discarded watchdog history'
mise exec -- jq -e '.operation == "uninstall" and .apply == true and .installed == false' \
  "$test_root/uninstall.json" >/dev/null || fail 'uninstall output is invalid'

echo 'cursoruiviewservice-watchdog tests passed'
