from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import plistlib
import re
import shlex
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

VERSION = "1.2.0"
SCHEMA_VERSION = 1
LABEL = "com.ipruning.cursoruiviewservice-watchdog"
SERVICE_LABEL = "com.apple.TextInputUI.xpc.CursorUIViewService"
EXPECTED_EXECUTABLE = Path(
    "/System/Library/PrivateFrameworks/TextInputUIMacHelper.framework/Versions/A/"
    "XPCServices/CursorUIViewService.xpc/Contents/MacOS/CursorUIViewService"
)
FOOTPRINT_THRESHOLD_BYTES = 512 * 1024**2
EARLY_RECYCLE_THRESHOLD_BYTES = 384 * 1024**2
REQUIRED_UNRESPONSIVE_SAMPLES = 3
COOLDOWN_SECONDS = 5 * 60
CHECK_INTERVAL_SECONDS = 60
WRAPPER_MARKER = "# managed by cursoruiviewservice-watchdog"
RESPONSIVENESS_SCRIPT = """
on run argv
  set targetPid to item 1 of argv as integer
  tell application "System Events"
    set matches to every application process whose unix id is targetPid
    if (count of matches) is 0 then return "not-running"
  end tell
  try
    with timeout of 1 seconds
      tell application "System Events"
        set targetProcess to item 1 of (every application process whose unix id is targetPid)
        set _ to value of attribute "AXFocusedUIElement" of targetProcess
      end tell
    end timeout
    return "responsive"
  on error errorMessage number errorNumber
    if errorNumber is -1712 then return "timeout"
    return "error:" & errorNumber & ":" & errorMessage
  end try
end run
"""

TEST_ROOT = os.getenv("CURSORUIVIEW_WATCHDOG_TEST_ROOT", "")
HOME = Path(TEST_ROOT) / "home" if TEST_ROOT else Path.home()
USER_BIN = HOME / ".local" / "bin" / "cursoruiviewservice-watchdog"
SUPPORT_DIR = HOME / "Library" / "Application Support" / "cursoruiviewservice-watchdog"
RUNTIME_CLI = SUPPORT_DIR / "cursoruiviewservice-watchdog"
STATE_FILE = SUPPORT_DIR / "state.json"
LOCK_FILE = SUPPORT_DIR / "watchdog.lock"
LOG_DIR = HOME / "Library" / "Logs" / "cursoruiviewservice-watchdog"
LAUNCH_AGENT = HOME / "Library" / "LaunchAgents" / f"{LABEL}.plist"


def test_binary(name: str, default: str) -> str:
    if not TEST_ROOT:
        return default
    return os.getenv(f"CURSORUIVIEW_WATCHDOG_{name}_BIN", default)


LAUNCHCTL_BIN = test_binary("LAUNCHCTL", "/bin/launchctl")
FOOTPRINT_BIN = test_binary("FOOTPRINT", "/usr/bin/footprint")
PS_BIN = test_binary("PS", "/bin/ps")
KILL_BIN = test_binary("KILL", "/bin/kill")
OSASCRIPT_BIN = test_binary("OSASCRIPT", "/usr/bin/osascript")
UNAME_BIN = test_binary("UNAME", "/usr/bin/uname")


class CliError(Exception):
    pass


@dataclass(frozen=True)
class ServiceSnapshot:
    running: bool
    pid: int | None
    footprint_bytes: int | None
    swapped_bytes: int | None


def utc_now() -> str:
    return dt.datetime.now(dt.UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def logfmt_quote(value: Any) -> str:
    if isinstance(value, bool):
        text = "true" if value else "false"
    elif value is None:
        text = ""
    else:
        text = str(value)
    text = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{text}"'


def emit(record: dict[str, Any], output_json: bool) -> None:
    document = {
        "schema_version": SCHEMA_VERSION,
        **record,
    }
    if output_json:
        print(json.dumps(document, ensure_ascii=False, sort_keys=True))
        return
    print(" ".join(f"{key}={logfmt_quote(value)}" for key, value in document.items()))


def run_command(
    command: list[str], *, timeout: float = 10
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            text=True,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CliError(f"could not run {command[0]}: {error}") from error


def agent_target() -> str:
    return f"gui/{os.getuid()}/{LABEL}"


def service_target() -> str:
    return f"user/{os.getuid()}/{SERVICE_LABEL}"


def launch_agent_loaded() -> bool:
    return run_command([LAUNCHCTL_BIN, "print", agent_target()]).returncode == 0


def service_available() -> bool:
    return run_command([LAUNCHCTL_BIN, "print", service_target()]).returncode == 0


def bootout_launch_agent() -> None:
    if not launch_agent_loaded():
        return
    result = run_command([LAUNCHCTL_BIN, "bootout", agent_target()])
    if result.returncode != 0:
        detail = (
            result.stderr.strip() or result.stdout.strip() or "launchctl bootout failed"
        )
        raise CliError(detail)
    deadline = time.monotonic() + 3
    while launch_agent_loaded():
        if time.monotonic() >= deadline:
            raise CliError(f"LaunchAgent is still loaded: {agent_target()}")
        time.sleep(0.1)


def bootstrap_launch_agent() -> None:
    result = run_command([
        LAUNCHCTL_BIN,
        "bootstrap",
        f"gui/{os.getuid()}",
        str(LAUNCH_AGENT),
    ])
    if result.returncode != 0:
        detail = (
            result.stderr.strip()
            or result.stdout.strip()
            or "launchctl bootstrap failed"
        )
        raise CliError(detail)
    if not launch_agent_loaded():
        raise CliError(f"LaunchAgent did not load: {agent_target()}")


def runtime_python() -> Path:
    if TEST_ROOT:
        return Path(sys.executable).resolve()
    mise_python = (
        Path.home()
        / ".local"
        / "share"
        / "mise"
        / "installs"
        / "python"
        / "latest"
        / "bin"
        / "python3"
    )
    if mise_python.is_file() and os.access(mise_python, os.X_OK):
        return mise_python
    return Path(sys.executable).resolve()


def managed_wrapper() -> bool:
    if not USER_BIN.is_file() or USER_BIN.is_symlink():
        return False
    try:
        return WRAPPER_MARKER in USER_BIN.read_text().splitlines()[:2]
    except OSError, UnicodeError:
        return False


def launch_agent_payload(python_bin: Path, auto_recycle: bool) -> dict[str, Any]:
    arguments = [str(python_bin), str(RUNTIME_CLI), "run"]
    if auto_recycle:
        arguments.append("--apply")
    arguments.append("--json")
    return {
        "Label": LABEL,
        "ProgramArguments": arguments,
        "RunAtLoad": True,
        "StartInterval": CHECK_INTERVAL_SECONDS,
        "ProcessType": "Background",
        "LowPriorityIO": True,
        "StandardOutPath": str(LOG_DIR / "agent.out.log"),
        "StandardErrorPath": str(LOG_DIR / "agent.err.log"),
    }


def atomic_write(path: Path, contents: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        temporary.write_bytes(contents)
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


def install_mode(apply: bool, auto_recycle: bool, output_json: bool) -> int:
    if run_command([UNAME_BIN, "-s"]).stdout.strip() != "Darwin":
        raise CliError("install is supported only on macOS")
    if not service_available():
        raise CliError(f"Apple XPC service is unavailable: {service_target()}")
    python_bin = runtime_python()
    if (USER_BIN.exists() or USER_BIN.is_symlink()) and not managed_wrapper():
        raise CliError(f"refusing to replace unmanaged executable: {USER_BIN}")

    payload = launch_agent_payload(python_bin, auto_recycle)
    plist_bytes = plistlib.dumps(payload, fmt=plistlib.FMT_XML, sort_keys=False)
    plistlib.loads(plist_bytes)
    record = {
        "operation": "install",
        "ok": True,
        "apply": apply,
        "executable": str(USER_BIN),
        "runtime": str(RUNTIME_CLI),
        "plist": str(LAUNCH_AGENT),
        "auto_recycle": auto_recycle,
        "interval_seconds": CHECK_INTERVAL_SECONDS,
        "threshold_bytes": FOOTPRINT_THRESHOLD_BYTES,
        "early_recycle_threshold_bytes": EARLY_RECYCLE_THRESHOLD_BYTES,
        "required_unresponsive_samples": REQUIRED_UNRESPONSIVE_SAMPLES,
    }
    if not apply:
        emit(record, output_json)
        return 0

    USER_BIN.parent.mkdir(parents=True, exist_ok=True)
    SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    LAUNCH_AGENT.parent.mkdir(parents=True, exist_ok=True)
    bootout_launch_agent()
    completed: list[str] = []
    try:
        source = Path(__file__).resolve().read_bytes()
        atomic_write(RUNTIME_CLI, source, 0o755)
        completed.append("runtime")
        wrapper = (
            "#!/bin/sh\n"
            f"{WRAPPER_MARKER}\n"
            f'exec {shlex.quote(str(python_bin))} {shlex.quote(str(RUNTIME_CLI))} "$@"\n'
        ).encode()
        atomic_write(USER_BIN, wrapper, 0o755)
        completed.append("executable")
        atomic_write(LAUNCH_AGENT, plist_bytes, 0o644)
        completed.append("plist")
        bootstrap_launch_agent()
        completed.append("bootstrap")
    except (CliError, OSError) as install_error:
        with contextlib.suppress(CliError):
            bootout_launch_agent()
        progress = ",".join(completed) or "none"
        raise CliError(
            f"install failed after completed={progress}; LaunchAgent was left unloaded; "
            f"inspect with `cursoruiviewservice-watchdog status`, then rerun install: {install_error}"
        ) from install_error

    emit(record, output_json)
    return 0


def load_state() -> dict[str, Any]:
    if not STATE_FILE.is_file():
        return {}
    try:
        state = json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise CliError(f"invalid watchdog state at {STATE_FILE}: {error}") from error
    if not isinstance(state, dict) or state.get("schema_version") != SCHEMA_VERSION:
        raise CliError(f"unsupported watchdog state at {STATE_FILE}")
    return state


def save_state(state: dict[str, Any]) -> None:
    state = {"schema_version": SCHEMA_VERSION, **state}
    atomic_write(
        STATE_FILE,
        (json.dumps(state, indent=2, sort_keys=True) + "\n").encode(),
        0o600,
    )


@contextlib.contextmanager
def operation_lock() -> Any:
    SUPPORT_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        yield


def launchd_service_pid() -> int | None:
    result = run_command([LAUNCHCTL_BIN, "print", service_target()])
    if result.returncode != 0:
        detail = result.stderr.strip() or "launchctl could not inspect the service"
        raise CliError(detail)
    pids = re.findall(r"^\s*pid = (\d+)\s*$", result.stdout, flags=re.MULTILINE)
    if not pids:
        return None
    if len(pids) != 1:
        raise CliError(f"launchctl reported {len(pids)} service PIDs")
    return int(pids[0])


def find_service_pid() -> int | None:
    pid = launchd_service_pid()
    if pid is None:
        return None
    process = run_command([PS_BIN, "-p", str(pid), "-o", "comm="])
    if process.returncode != 0:
        raise CliError(f"service PID {pid} exited during inspection")
    if process.stdout.strip() != str(EXPECTED_EXECUTABLE):
        raise CliError(f"service PID {pid} has an unexpected executable")
    return pid


def measure_footprint(pid: int) -> tuple[int, int]:
    fd, output_name = tempfile.mkstemp(
        prefix="cursoruiviewservice-footprint.", suffix=".json"
    )
    os.close(fd)
    output = Path(output_name)
    output.unlink()
    try:
        result = run_command(
            [
                FOOTPRINT_BIN,
                "--pid",
                str(pid),
                "--noCategories",
                "--format",
                "bytes",
                "--json",
                str(output),
            ],
            timeout=15,
        )
        if result.returncode != 0:
            detail = (
                result.stderr.strip() or result.stdout.strip() or "footprint failed"
            )
            raise CliError(detail)
        try:
            document = json.loads(output.read_text())
            processes = document["processes"]
            process = next(item for item in processes if item["pid"] == pid)
            footprint = int(process["auxiliary"]["phys_footprint"])
            swapped = int(document["summary"]["total"]["swapped"])
        except (
            OSError,
            KeyError,
            StopIteration,
            TypeError,
            ValueError,
            json.JSONDecodeError,
        ) as error:
            raise CliError("footprint returned an invalid JSON document") from error
        if document.get("errors"):
            raise CliError(f"footprint reported errors: {document['errors']}")
        return footprint, swapped
    finally:
        with contextlib.suppress(FileNotFoundError):
            output.unlink()


def inspect_service() -> ServiceSnapshot:
    pid = find_service_pid()
    if pid is None:
        return ServiceSnapshot(False, None, None, None)
    footprint, swapped = measure_footprint(pid)
    return ServiceSnapshot(True, pid, footprint, swapped)


def probe_responsiveness(pid: int) -> tuple[str, str]:
    try:
        result = run_command(
            [OSASCRIPT_BIN, "-e", RESPONSIVENESS_SCRIPT, str(pid)], timeout=4
        )
    except CliError as error:
        return "error", str(error)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "osascript failed"
        return "error", detail
    response = result.stdout.strip()
    if response in {"responsive", "timeout", "not-running"}:
        return response, ""
    if response.startswith("error:"):
        return "error", response
    return "error", f"unexpected responsiveness probe output: {response or 'empty'}"


def snapshot_record(snapshot: ServiceSnapshot) -> dict[str, Any]:
    return {
        "running": snapshot.running,
        "pid": snapshot.pid,
        "footprint_bytes": snapshot.footprint_bytes,
        "swapped_bytes": snapshot.swapped_bytes,
        "threshold_bytes": FOOTPRINT_THRESHOLD_BYTES,
        "early_recycle_threshold_bytes": EARLY_RECYCLE_THRESHOLD_BYTES,
    }


def check_mode(output_json: bool) -> int:
    snapshot = inspect_service()
    high = bool(
        snapshot.footprint_bytes is not None
        and snapshot.footprint_bytes >= FOOTPRINT_THRESHOLD_BYTES
    )
    early_high = bool(
        snapshot.footprint_bytes is not None
        and snapshot.footprint_bytes >= EARLY_RECYCLE_THRESHOLD_BYTES
    )
    responsiveness = "not-running"
    probe_error = ""
    if snapshot.pid is not None:
        responsiveness, probe_error = probe_responsiveness(snapshot.pid)
    emit(
        {
            "operation": "check",
            "ok": True,
            **snapshot_record(snapshot),
            "high": high,
            "early_high": early_high,
            "responsiveness": responsiveness,
            "unresponsive": responsiveness == "timeout",
            "probe_error": probe_error,
        },
        output_json,
    )
    return 1 if high or responsiveness == "timeout" else 0


def kill_service(old_pid: int) -> tuple[int | None, int | None]:
    if find_service_pid() != old_pid:
        raise CliError("service PID changed before recycle; refusing to kill it")
    result = run_command([KILL_BIN, "-KILL", str(old_pid)])
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "kill failed"
        raise CliError(detail)

    deadline = time.monotonic() + 5
    stopped = False
    while time.monotonic() < deadline:
        new_pid = launchd_service_pid()
        if new_pid is None:
            stopped = True
        elif new_pid != old_pid:
            process = run_command([PS_BIN, "-p", str(new_pid), "-o", "comm="])
            if process.returncode != 0:
                stopped = True
                time.sleep(0.1)
                continue
            if process.stdout.strip() != str(EXPECTED_EXECUTABLE):
                raise CliError(
                    f"replacement PID {new_pid} has an unexpected executable"
                )
            footprint, _ = measure_footprint(new_pid)
            if footprint >= FOOTPRINT_THRESHOLD_BYTES:
                raise CliError(
                    f"replacement service footprint remains high: {footprint} bytes"
                )
            return new_pid, footprint
        else:
            process = run_command([PS_BIN, "-p", str(old_pid), "-o", "comm="])
            if process.returncode != 0 or process.stdout.strip() != str(
                EXPECTED_EXECUTABLE
            ):
                stopped = True
        time.sleep(0.1)
    if stopped:
        return None, None
    raise CliError("service PID remained alive after SIGKILL")


def run_mode(apply: bool, output_json: bool) -> int:
    if not apply:
        snapshot = inspect_service()
        high = bool(
            snapshot.footprint_bytes is not None
            and snapshot.footprint_bytes >= FOOTPRINT_THRESHOLD_BYTES
        )
        early_high = bool(
            snapshot.footprint_bytes is not None
            and snapshot.footprint_bytes >= EARLY_RECYCLE_THRESHOLD_BYTES
        )
        responsiveness = "not-probed"
        probe_error = ""
        if snapshot.pid is not None and early_high and not high:
            responsiveness, probe_error = probe_responsiveness(snapshot.pid)
        emit(
            {
                "operation": "run",
                "ok": True,
                "apply": False,
                **snapshot_record(snapshot),
                "high": high,
                "early_high": early_high,
                "responsiveness": responsiveness,
                "probe_error": probe_error,
                "required_unresponsive_samples": REQUIRED_UNRESPONSIVE_SAMPLES,
                "result": "preview",
            },
            output_json,
        )
        return 0

    with operation_lock():
        snapshot = inspect_service()
        state = load_state()
        now = int(time.time())
        high = bool(
            snapshot.footprint_bytes is not None
            and snapshot.footprint_bytes >= FOOTPRINT_THRESHOLD_BYTES
        )
        early_high = bool(
            snapshot.footprint_bytes is not None
            and snapshot.footprint_bytes >= EARLY_RECYCLE_THRESHOLD_BYTES
        )
        responsiveness = "not-probed"
        probe_error = ""
        base = {
            "operation": "run",
            "ok": True,
            "apply": True,
            **snapshot_record(snapshot),
            "high": high,
            "early_high": early_high,
            "required_unresponsive_samples": REQUIRED_UNRESPONSIVE_SAMPLES,
        }
        if not snapshot.running:
            state.update({
                "last_check_at": utc_now(),
                "last_result": "not-running",
                "last_probe_result": "not-running",
                "last_probe_error": "",
                "unresponsive_pid": None,
                "unresponsive_streak": 0,
            })
            save_state(state)
            emit(
                {
                    **base,
                    "responsiveness": "not-running",
                    "probe_error": "",
                    "unresponsive_streak": 0,
                    "result": "not-running",
                },
                output_json,
            )
            return 0

        assert snapshot.pid is not None and snapshot.footprint_bytes is not None
        if not early_high:
            state.update({
                "last_check_at": utc_now(),
                "last_error": "",
                "last_result": "healthy",
                "last_footprint_bytes": snapshot.footprint_bytes,
                "last_probe_result": "not-probed",
                "last_probe_error": "",
                "unresponsive_pid": None,
                "unresponsive_streak": 0,
            })
            save_state(state)
            emit(
                {
                    **base,
                    "responsiveness": responsiveness,
                    "probe_error": probe_error,
                    "unresponsive_streak": 0,
                    "result": "healthy",
                },
                output_json,
            )
            return 0

        unresponsive_streak = 0
        recycle_reason = "hard-threshold"
        if not high:
            responsiveness, probe_error = probe_responsiveness(snapshot.pid)
            if responsiveness == "timeout":
                unresponsive_streak = (
                    int(state.get("unresponsive_streak", 0)) + 1
                    if state.get("unresponsive_pid") == snapshot.pid
                    else 1
                )
                state.update({
                    "unresponsive_pid": snapshot.pid,
                    "unresponsive_streak": unresponsive_streak,
                })
            else:
                state.update({
                    "unresponsive_pid": None,
                    "unresponsive_streak": 0,
                })
        else:
            responsiveness = "not-required"
            state.update({
                "unresponsive_pid": None,
                "unresponsive_streak": 0,
            })

        state.update({
            "last_check_at": utc_now(),
            "last_footprint_bytes": snapshot.footprint_bytes,
            "last_probe_result": responsiveness,
            "last_probe_error": probe_error,
        })
        base.update({
            "responsiveness": responsiveness,
            "probe_error": probe_error,
            "unresponsive_streak": unresponsive_streak,
        })

        if not high and responsiveness != "timeout":
            result = (
                "deferred-service-changed"
                if responsiveness == "not-running"
                else "deferred-probe-error"
                if responsiveness == "error"
                else "healthy"
            )
            state.update({
                "last_error": "",
                "last_result": result,
            })
            save_state(state)
            emit({**base, "result": result}, output_json)
            return 0

        if not high and unresponsive_streak < REQUIRED_UNRESPONSIVE_SAMPLES:
            state.update({
                "last_error": "",
                "last_result": "deferred-unresponsive-streak",
            })
            save_state(state)
            emit({**base, "result": "deferred-unresponsive-streak"}, output_json)
            return 0

        if not high:
            recycle_reason = "unresponsive"

        last_attempt = int(state.get("last_recycle_attempt_epoch", 0))
        if now - last_attempt < COOLDOWN_SECONDS:
            remaining = COOLDOWN_SECONDS - (now - last_attempt)
            state["last_result"] = "deferred-cooldown"
            save_state(state)
            emit(
                {
                    **base,
                    "result": "deferred-cooldown",
                    "recycle_reason": recycle_reason,
                    "cooldown_remaining_seconds": remaining,
                },
                output_json,
            )
            return 0

        confirmation = inspect_service()
        confirmation_threshold = (
            FOOTPRINT_THRESHOLD_BYTES
            if recycle_reason == "hard-threshold"
            else EARLY_RECYCLE_THRESHOLD_BYTES
        )
        if (
            confirmation.pid != snapshot.pid
            or confirmation.footprint_bytes is None
            or confirmation.footprint_bytes < confirmation_threshold
        ):
            state.update({
                "last_result": "deferred-service-changed",
            })
            save_state(state)
            emit(
                {
                    **base,
                    "result": "deferred-service-changed",
                    "current_pid": confirmation.pid,
                },
                output_json,
            )
            return 0

        if recycle_reason == "unresponsive":
            confirmation_responsiveness, confirmation_error = probe_responsiveness(
                snapshot.pid
            )
            state.update({
                "last_probe_result": confirmation_responsiveness,
                "last_probe_error": confirmation_error,
            })
            if confirmation_responsiveness != "timeout":
                state.update({
                    "last_result": "deferred-responsiveness-changed",
                    "unresponsive_pid": None,
                    "unresponsive_streak": 0,
                })
                save_state(state)
                emit(
                    {
                        **base,
                        "result": "deferred-responsiveness-changed",
                        "confirmation_responsiveness": confirmation_responsiveness,
                        "confirmation_probe_error": confirmation_error,
                    },
                    output_json,
                )
                return 0

        state.update({
            "last_recycle_attempt_at": utc_now(),
            "last_recycle_attempt_epoch": now,
            "last_result": "recycling",
            "last_recycle_reason": recycle_reason,
        })
        save_state(state)
        try:
            new_pid, new_footprint = kill_service(snapshot.pid)
        except CliError as error:
            state.update({"last_result": "recycle-failed", "last_error": str(error)})
            save_state(state)
            raise
        state.update({
            "last_result": "recycled",
            "last_error": "",
            "last_recycled_at": utc_now(),
            "last_old_pid": snapshot.pid,
            "last_new_pid": new_pid,
            "last_new_footprint_bytes": new_footprint,
            "unresponsive_pid": None,
            "unresponsive_streak": 0,
        })
        save_state(state)
        emit(
            {
                **base,
                "result": "recycled",
                "recycle_reason": recycle_reason,
                "old_pid": snapshot.pid,
                "new_pid": new_pid,
                "new_footprint_bytes": new_footprint,
            },
            output_json,
        )
        return 0


def recycle_mode(apply: bool, output_json: bool) -> int:
    with operation_lock() if apply else contextlib.nullcontext():
        snapshot = inspect_service()
        record = {
            "operation": "recycle",
            "ok": True,
            "apply": apply,
            **snapshot_record(snapshot),
        }
        if not snapshot.running or snapshot.pid is None:
            emit({**record, "result": "not-running"}, output_json)
            return 0
        if not apply:
            emit(
                {
                    **record,
                    "result": "preview",
                    "target": service_target(),
                    "action": "kill -KILL",
                },
                output_json,
            )
            return 0
        new_pid, new_footprint = kill_service(snapshot.pid)
        state = load_state()
        state.update({
            "last_recycle_attempt_at": utc_now(),
            "last_recycle_attempt_epoch": int(time.time()),
            "last_result": "recycled-manually",
            "last_recycle_reason": "manual",
            "last_recycled_at": utc_now(),
            "last_old_pid": snapshot.pid,
            "last_new_pid": new_pid,
            "last_new_footprint_bytes": new_footprint,
            "unresponsive_pid": None,
            "unresponsive_streak": 0,
        })
        save_state(state)
        emit(
            {
                **record,
                "result": "recycled",
                "old_pid": snapshot.pid,
                "new_pid": new_pid,
                "new_footprint_bytes": new_footprint,
            },
            output_json,
        )
        return 0


def status_mode(output_json: bool) -> int:
    state_error = ""
    try:
        state = load_state()
    except CliError as error:
        state = {}
        state_error = str(error)
    record = {
        "operation": "status",
        "ok": not state_error,
        "installed": managed_wrapper()
        and RUNTIME_CLI.is_file()
        and LAUNCH_AGENT.is_file(),
        "loaded": launch_agent_loaded(),
        "service_available": service_available(),
        "auto_recycle": installed_auto_recycle(),
        "executable": str(USER_BIN),
        "runtime": str(RUNTIME_CLI),
        "plist": str(LAUNCH_AGENT),
        "service_target": service_target(),
        "threshold_bytes": FOOTPRINT_THRESHOLD_BYTES,
        "early_recycle_threshold_bytes": EARLY_RECYCLE_THRESHOLD_BYTES,
        "required_unresponsive_samples": REQUIRED_UNRESPONSIVE_SAMPLES,
        "interval_seconds": CHECK_INTERVAL_SECONDS,
        "cooldown_seconds": COOLDOWN_SECONDS,
        "last_result": state.get("last_result"),
        "last_check_at": state.get("last_check_at"),
        "last_recycled_at": state.get("last_recycled_at"),
        "last_recycle_reason": state.get("last_recycle_reason"),
        "last_probe_result": state.get("last_probe_result"),
        "last_probe_error": state.get("last_probe_error", ""),
        "unresponsive_pid": state.get("unresponsive_pid"),
        "unresponsive_streak": state.get("unresponsive_streak", 0),
        "last_error": state_error or state.get("last_error", ""),
    }
    emit(record, output_json)
    return (
        0
        if record["installed"]
        and record["loaded"]
        and record["service_available"]
        and record["ok"]
        else 1
    )


def installed_auto_recycle() -> bool | None:
    if not LAUNCH_AGENT.is_file():
        return None
    try:
        payload = plistlib.loads(LAUNCH_AGENT.read_bytes())
        return "--apply" in payload["ProgramArguments"]
    except OSError, KeyError, TypeError, plistlib.InvalidFileException:
        return None


def uninstall_mode(apply: bool, output_json: bool) -> int:
    if USER_BIN.exists() and not managed_wrapper():
        raise CliError(f"refusing to remove unmanaged executable: {USER_BIN}")
    if not apply:
        emit(
            {
                "operation": "uninstall",
                "ok": True,
                "apply": False,
                "result": "preview",
                "loaded": launch_agent_loaded(),
                "state_preserved": str(STATE_FILE),
            },
            output_json,
        )
        return 0
    bootout_launch_agent()
    for path in (LAUNCH_AGENT, USER_BIN, RUNTIME_CLI):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
    if launch_agent_loaded() or any(
        path.exists() for path in (LAUNCH_AGENT, USER_BIN, RUNTIME_CLI)
    ):
        raise CliError("uninstall verification failed")
    emit(
        {
            "operation": "uninstall",
            "ok": True,
            "apply": True,
            "installed": False,
            "loaded": False,
            "state_preserved": str(STATE_FILE),
        },
        output_json,
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Recycle a leaking macOS CursorUIViewService without a PID kill loop."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    install = subparsers.add_parser(
        "install", help="Preview or install the LaunchAgent."
    )
    install.add_argument("--apply", action="store_true")
    install.add_argument(
        "--auto-recycle",
        action="store_true",
        help="Opt in to guarded automatic recycling.",
    )
    install.add_argument("--json", action="store_true")

    status = subparsers.add_parser(
        "status", help="Show installation and last-run state."
    )
    status.add_argument("--json", action="store_true")

    check = subparsers.add_parser(
        "check", help="Inspect the service without changing state."
    )
    check.add_argument("--json", action="store_true")

    run = subparsers.add_parser("run", help="Preview or run one automatic check.")
    run.add_argument("--apply", action="store_true")
    run.add_argument("--json", action="store_true")

    recycle = subparsers.add_parser(
        "recycle", help="Preview or explicitly recycle the service."
    )
    recycle.add_argument("--apply", action="store_true")
    recycle.add_argument("--json", action="store_true")

    uninstall = subparsers.add_parser(
        "uninstall", help="Preview or remove installed files."
    )
    uninstall.add_argument("--apply", action="store_true")
    uninstall.add_argument("--json", action="store_true")

    subparsers.add_parser("version", help="Show the CLI version.")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        if args.command == "install":
            return install_mode(args.apply, args.auto_recycle, args.json)
        if args.command == "status":
            return status_mode(args.json)
        if args.command == "check":
            return check_mode(args.json)
        if args.command == "run":
            return run_mode(args.apply, args.json)
        if args.command == "recycle":
            return recycle_mode(args.apply, args.json)
        if args.command == "uninstall":
            return uninstall_mode(args.apply, args.json)
        if args.command == "version":
            print(f"cursoruiviewservice-watchdog {VERSION}")
            return 0
        raise CliError(f"unknown command: {args.command}")
    except CliError as error:
        output_json = bool(getattr(args, "json", False))
        if output_json:
            document: dict[str, Any] = {
                "schema_version": SCHEMA_VERSION,
                "operation": args.command,
                "ok": False,
                "error": str(error),
            }
            if args.command in {"install", "run", "recycle", "uninstall"}:
                document["apply"] = bool(getattr(args, "apply", False))
            print(json.dumps(document, ensure_ascii=False, sort_keys=True))
        else:
            print(f"cursoruiviewservice-watchdog: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
