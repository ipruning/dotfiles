#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"
export PATH="$HOME/.local/bin:$PATH"

# Snapshots retain tools and .venv. Check readiness without downloads or repairs.
# Run .agents/setup explicitly if the lockfiles or installed dependencies differ.
mise exec -- uv sync --locked --check --offline --no-python-downloads
