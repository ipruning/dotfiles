def open_read_db(db_path: Path) -> sqlite3.Connection:
    try:
        conn = sqlite3.connect(f"{db_path.resolve().as_uri()}?mode=ro", uri=True)
    except sqlite3.Error as exc:
        raise CliError("unable to open database") from exc
    conn.row_factory = sqlite3.Row
    return conn


def run_command(
    args: list[str],
    *,
    timeout: float,
    input_text: str | None = None,
) -> tuple[int, str, str, bool, float]:
    started = time.monotonic()
    try:
        completed = subprocess.run(
            args,
            input=input_text,
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        duration_ms = (time.monotonic() - started) * 1000
        return (
            completed.returncode,
            completed.stdout,
            completed.stderr,
            False,
            duration_ms,
        )
    except subprocess.TimeoutExpired as exc:
        duration_ms = (time.monotonic() - started) * 1000
        stdout = exc.stdout or ""
        stderr = exc.stderr or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode("utf-8", errors="replace")
        if isinstance(stderr, bytes):
            stderr = stderr.decode("utf-8", errors="replace")
        return 124, stdout, stderr, True, duration_ms
    except OSError as exc:
        duration_ms = (time.monotonic() - started) * 1000
        return 127, "", f"{type(exc).__name__}: {exc}", False, duration_ms


class Store:
    def __init__(self, db_path: Path | None, emit_stdout: bool = True) -> None:
        self.db_path = db_path
        self.emit_stdout = emit_stdout
        self.conn: sqlite3.Connection | None = None
        if db_path is not None:
            db_path.parent.mkdir(parents=True, exist_ok=True)
            self.conn = sqlite3.connect(db_path)
            self.conn.execute("PRAGMA journal_mode=WAL")
            self.conn.execute("PRAGMA synchronous=NORMAL")
            self.conn.execute("PRAGMA busy_timeout=5000")
            self.conn.execute("PRAGMA foreign_keys=ON")
            self._init_schema()

    def _init_schema(self) -> None:
        assert self.conn is not None
        self.conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS snapshots (
              id TEXT PRIMARY KEY,
              started_at TEXT NOT NULL,
              ended_at TEXT,
              hostname TEXT NOT NULL,
              username TEXT NOT NULL,
              pid INTEGER NOT NULL,
              mode TEXT NOT NULL,
              app_paths_json TEXT NOT NULL,
              status TEXT
            );

            CREATE TABLE IF NOT EXISTS events (
              id INTEGER PRIMARY KEY AUTOINCREMENT,
              snapshot_id TEXT NOT NULL REFERENCES snapshots(id) ON DELETE CASCADE,
              ts TEXT NOT NULL,
              event TEXT NOT NULL,
              severity TEXT,
              data_json TEXT NOT NULL
            );

            CREATE INDEX IF NOT EXISTS idx_events_snapshot ON events(snapshot_id);
            CREATE INDEX IF NOT EXISTS idx_events_event_ts ON events(event, ts);
            CREATE TABLE IF NOT EXISTS state (
              key TEXT PRIMARY KEY,
              value TEXT NOT NULL,
              updated_at TEXT NOT NULL
            );
            """
        )
        self.conn.commit()

    def create_snapshot(self, mode: str) -> str:
        snapshot_id = str(uuid.uuid4())
        if self.conn is not None:
            # app_paths_json is a retired column kept so existing databases
            # and new ones share one schema.
            self.conn.execute(
                """
                INSERT INTO snapshots
                  (id, started_at, hostname, username, pid, mode, app_paths_json)
                VALUES (?, ?, ?, ?, ?, ?, '[]')
                """,
                (
                    snapshot_id,
                    utc_now(),
                    socket.gethostname(),
                    getpass.getuser(),
                    os.getpid(),
                    mode,
                ),
            )
            self.conn.commit()
        return snapshot_id

    def finish_snapshot(self, snapshot_id: str, status: str) -> None:
        if self.conn is None:
            return
        self.conn.execute(
            "UPDATE snapshots SET ended_at = ?, status = ? WHERE id = ?",
            (utc_now(), status, snapshot_id),
        )
        self.conn.commit()

    def prune(self, retention_days: int | None) -> int:
        if self.conn is None or retention_days is None or retention_days <= 0:
            return 0
        cutoff = (
            (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=retention_days))
            .isoformat(timespec="seconds")
            .replace("+00:00", "Z")
        )
        cursor = self.conn.execute(
            "DELETE FROM snapshots WHERE started_at < ?", (cutoff,)
        )
        return cursor.rowcount

    def get_state(self, key: str) -> str | None:
        if self.conn is None:
            return None
        row = self.conn.execute(
            "SELECT value FROM state WHERE key = ?", (key,)
        ).fetchone()
        return None if row is None else str(row[0])

    def set_state(self, key: str, value: str) -> None:
        if self.conn is None:
            return
        self.conn.execute(
            """
            INSERT INTO state (key, value, updated_at)
            VALUES (?, ?, ?)
            ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at
            """,
            (key, value, utc_now()),
        )

    def emit(
        self, snapshot_id: str, event: str, severity: str | None = None, **data: Any
    ) -> None:
        ts = utc_now()
        if self.emit_stdout:
            parts = [f"ts={logfmt_quote(ts)}", f"event={logfmt_quote(event)}"]
            if severity is not None:
                parts.append(f"severity={logfmt_quote(severity)}")
            for key, value in data.items():
                parts.append(f"{key}={logfmt_quote(value)}")
            print(" ".join(parts), flush=True)

        if self.conn is not None:
            self.conn.execute(
                """
                INSERT INTO events (snapshot_id, ts, event, severity, data_json)
                VALUES (?, ?, ?, ?, ?)
                """,
                (
                    snapshot_id,
                    ts,
                    event,
                    severity,
                    json.dumps(data, ensure_ascii=False),
                ),
            )

    def close(self) -> None:
        if self.conn is not None:
            self.conn.close()


def parse_int(value: Any) -> int | None:
    try:
        return int(value)
    except TypeError, ValueError:
        return None


def parse_float(value: Any) -> float | None:
    try:
        return float(value)
    except TypeError, ValueError:
        return None


def parse_iso(value: str) -> dt.datetime | None:
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except AttributeError, ValueError:
        return None


def observation(state: str, value: Any = "", detail: str = "") -> dict[str, Any]:
    return {"state": state, "value": value, "detail": detail}


def should_run_periodic(store: Store, key: str, interval_minutes: int) -> bool:
    if interval_minutes <= 0:
        return False
    state_key = f"last_probe_at:{key}"
    last = parse_iso(store.get_state(state_key) or "")
    now = dt.datetime.now(dt.timezone.utc)
    if last is not None and now - last < dt.timedelta(minutes=interval_minutes):
        return False
    store.set_state(state_key, utc_now())
    return True


def probe_spawn(store: Store, snapshot_id: str, timeout: float) -> dict[str, Any]:
    checks = [
        ("true", ["/usr/bin/true"]),
        ("bash_colon", ["/bin/bash", "-c", ":"]),
        ("zsh_colon", ["/bin/zsh", "-c", ":"]),
        ("python_import_sqlite", ["/usr/bin/python3", "-c", "import sqlite3"]),
    ]
    failures: list[str] = []
    for name, command in checks:
        code, _out, err, timed_out, duration_ms = run_command(command, timeout=timeout)
        store.emit(
            snapshot_id,
            "spawn_check",
            name=name,
            command=shlex.join(command),
            exit=code,
            timeout=timed_out,
            duration_ms=round(duration_ms, 1),
            stderr=err.strip(),
        )
        if code != 0 or timed_out:
            failures.append(f"{name} {'超时' if timed_out else f'退出码 {code}'}")
    if failures:
        return observation("bad", len(failures), "启动检查失败：" + "，".join(failures))
    return observation("ok")


def sample_processes(
    store: Store, snapshot_id: str, timeout: float
) -> list[dict[str, Any]] | None:
    code, out, err, timed_out, duration_ms = run_command(
        ["ps", "-axo", "user=,pid=,ppid=,stat=,%cpu=,rss=,etime=,comm="],
        timeout=timeout,
    )
    if code != 0 or timed_out:
        store.emit(
            snapshot_id,
            "process_table",
            exit=code,
            timeout=timed_out,
            duration_ms=round(duration_ms, 1),
            error=err.strip(),
        )
        return None
    rows: list[dict[str, Any]] = []
    for line in out.splitlines():
        parts = line.split(None, 7)
        if len(parts) < 8:
            continue
        user, pid, ppid, stat, cpu, rss, etime, comm = parts
        rss_kb = parse_int(rss)
        rows.append({
            "user": user,
            "pid": pid,
            "ppid": ppid,
            "stat": stat,
            "cpu_percent": parse_float(cpu) or 0.0,
            "rss_mb": round(rss_kb / 1024, 1) if rss_kb is not None else None,
            "etime": etime,
            "comm": comm,
        })
    current_user = getpass.getuser()
    store.emit(
        snapshot_id,
        "process_table",
        exit=code,
        timeout=False,
        duration_ms=round(duration_ms, 1),
        total=len(rows),
        user=current_user,
        user_total=sum(1 for row in rows if row["user"] == current_user),
    )
    return rows


def read_kernel_limits(
    store: Store, snapshot_id: str, timeout: float
) -> dict[str, int] | None:
    names = ["kern.maxproc", "kern.maxprocperuid", "kern.num_files", "kern.maxfiles"]
    code, out, err, timed_out, duration_ms = run_command(
        ["sysctl", *names], timeout=timeout
    )
    values: dict[str, int] = {}
    for line in out.splitlines():
        name, _, raw = line.partition(":")
        value = parse_int(raw.strip())
        if name in names and value is not None:
            values[name] = value
    store.emit(
        snapshot_id,
        "kernel_limits",
        exit=code,
        timeout=timed_out,
        duration_ms=round(duration_ms, 1),
        error=err.strip(),
        **{name.replace(".", "_"): values.get(name, "") for name in names},
    )
    if code != 0 or timed_out or len(values) != len(names):
        return None
    return values


def probe_process_table(
    rows: list[dict[str, Any]] | None,
    limits: dict[str, int] | None,
    warn_pct: int,
) -> dict[str, Any]:
    if rows is None or limits is None:
        return observation("unknown", detail="进程表或内核上限读取失败")
    current_user = getpass.getuser()
    total = len(rows)
    user_total = sum(1 for row in rows if row["user"] == current_user)
    pressure = [
        (total, limits["kern.maxproc"], "全系统"),
        (user_total, limits["kern.maxprocperuid"], f"用户 {current_user} 的"),
    ]
    for used, limit, scope in pressure:
        if limit and used * 100 >= limit * warn_pct:
            return observation(
                "bad",
                round(used * 100 / limit, 1),
                f"{scope}进程数 {used}/{limit}",
            )
    return observation("ok", round(total * 100 / limits["kern.maxproc"], 1))


def probe_file_table(limits: dict[str, int] | None, warn_pct: int) -> dict[str, Any]:
    if limits is None:
        return observation("unknown", detail="内核上限读取失败")
    used = limits["kern.num_files"]
    limit = limits["kern.maxfiles"]
    pct = round(used * 100 / limit, 1) if limit else 0.0
    if limit and used * 100 >= limit * warn_pct:
        return observation("bad", pct, f"系统打开文件数 {used}/{limit}")
    return observation("ok", pct)


def probe_syspolicyd_rss(
    store: Store,
    snapshot_id: str,
    rows: list[dict[str, Any]] | None,
    limit_mb: float,
) -> dict[str, Any]:
    if rows is None:
        return observation("unknown", detail="进程表读取失败")
    matches = [row for row in rows if Path(row["comm"]).name == "syspolicyd"]
    if not matches:
        return observation("unknown", detail="未找到 syspolicyd 进程")
    row = max(matches, key=lambda item: item["rss_mb"] or 0)
    store.emit(
        snapshot_id,
        "syspolicyd_resource",
        pid=row["pid"],
        stat=row["stat"],
        cpu_percent=row["cpu_percent"],
        rss_mb=row["rss_mb"],
        etime=row["etime"],
    )
    rss_mb = row["rss_mb"]
    if rss_mb is None:
        return observation("unknown", detail="syspolicyd RSS 无法解析")
    if rss_mb >= limit_mb:
        return observation(
            "bad", rss_mb, f"syspolicyd RSS {rss_mb} MiB（阈值 {limit_mb:g}）"
        )
    return observation("ok", rss_mb)


def classify_syspolicyd_log_line(line: str) -> str | None:
    lower = line.lower()
    if "syspolicyd[" not in lower:
        return None
    if "too many open files" in lower or "unix error exception: 24" in lower:
        return "fd_exhausted"
    if "failed to generate secstaticcode" in lower:
        return "assessment_failed"
    return None


def probe_syspolicyd_log(
    store: Store,
    snapshot_id: str,
    *,
    timeout: float,
    last_minutes: int,
    assessment_failure_limit: int,
    max_lines: int,
) -> dict[str, Any]:
    predicate = (
        'process == "syspolicyd" AND ('
        'eventMessage CONTAINS[c] "Too many open files" OR '
        'eventMessage CONTAINS[c] "UNIX error exception: 24" OR '
        'eventMessage CONTAINS[c] "Failed to generate SecStaticCode")'
    )
    code, out, err, timed_out, duration_ms = run_command(
        [
            "/usr/bin/log",
            "show",
            "--last",
            f"{last_minutes}m",
            "--style",
            "compact",
            "--predicate",
            predicate,
        ],
        timeout=timeout,
    )
    counts = {"fd_exhausted": 0, "assessment_failed": 0}
    matched: list[tuple[str, str]] = []
    for line in out.splitlines():
        category = classify_syspolicyd_log_line(line)
        if category is not None:
            counts[category] += 1
            matched.append((category, line))
    store.emit(
        snapshot_id,
        "syspolicyd_log_scan",
        exit=code,
        timeout=timed_out,
        duration_ms=round(duration_ms, 1),
        last_minutes=last_minutes,
        error=err.strip() if code != 0 else "",
        **counts,
    )
    for category, line in matched[-max_lines:]:
        store.emit(snapshot_id, "syspolicyd_log_match", category=category, line=line)
    if code != 0 or timed_out:
        return observation("unknown", detail="日志扫描未完成")
    if counts["fd_exhausted"]:
        return observation(
            "bad",
            counts["fd_exhausted"],
            f"最近 {last_minutes} 分钟 syspolicyd 报告 {counts['fd_exhausted']} 次打开文件数耗尽",
        )
    if counts["assessment_failed"] >= assessment_failure_limit:
        return observation(
            "bad",
            counts["assessment_failed"],
            f"最近 {last_minutes} 分钟 syspolicyd 签名评估失败 {counts['assessment_failed']} 次",
        )
    return observation("ok", counts["assessment_failed"])


def collect_evidence(
    store: Store,
    snapshot_id: str,
    rows: list[dict[str, Any]] | None,
    args: argparse.Namespace,
) -> None:
    """Record bounded context for the incident report while a symptom is bad."""
    loadavg = os.getloadavg()
    boot_code, boot_out, _, _, _ = run_command(
        ["sysctl", "-n", "kern.boottime"], timeout=args.command_timeout
    )
    store.emit(
        snapshot_id,
        "evidence_system_context",
        hostname=socket.gethostname(),
        loadavg_1=round(loadavg[0], 2),
        loadavg_5=round(loadavg[1], 2),
        loadavg_15=round(loadavg[2], 2),
        boottime=boot_out.strip() if boot_code == 0 else "",
    )

    if rows is not None:
        top = sorted(rows, key=lambda row: row["cpu_percent"], reverse=True)
        store.emit(snapshot_id, "evidence_cpu_top", rows=top[: args.top])
        commands: dict[str, int] = {}
        parents: dict[str, int] = {}
        pid_commands = {row["pid"]: row["comm"] for row in rows}
        zombies: list[dict[str, Any]] = []
        for row in rows:
            commands[row["comm"]] = commands.get(row["comm"], 0) + 1
            parents[row["ppid"]] = parents.get(row["ppid"], 0) + 1
            if "Z" in row["stat"]:
                zombies.append({
                    "pid": row["pid"],
                    "ppid": row["ppid"],
                    "parent_comm": pid_commands.get(row["ppid"], ""),
                })
        store.emit(
            snapshot_id,
            "evidence_process_counts",
            by_command=[
                {"comm": comm, "count": count}
                for comm, count in sorted(
                    commands.items(), key=lambda item: item[1], reverse=True
                )[: args.top]
            ],
            by_parent=[
                {
                    "ppid": ppid,
                    "parent_comm": pid_commands.get(ppid, ""),
                    "count": count,
                }
                for ppid, count in sorted(
                    parents.items(), key=lambda item: item[1], reverse=True
                )[: args.top]
            ],
            zombies=zombies[: args.top],
        )

    code, out, err, timed_out, duration_ms = run_command(
        ["lsof", "-nP", "-F", "pc"], timeout=args.lsof_timeout
    )
    fd_counts: dict[str, int] = {}
    fd_commands: dict[str, str] = {}
    pid = ""
    for line in out.splitlines():
        if line.startswith("p"):
            pid = line[1:]
            fd_counts.setdefault(pid, 0)
        elif line.startswith("c"):
            fd_commands[pid] = line[1:]
        elif line.startswith("f") and pid:
            fd_counts[pid] += 1
    store.emit(
        snapshot_id,
        "evidence_fd_top",
        exit=code,
        timeout=timed_out,
        duration_ms=round(duration_ms, 1),
        rows=[
            {"pid": pid, "comm": fd_commands.get(pid, ""), "count": count}
            for pid, count in sorted(
                fd_counts.items(), key=lambda item: item[1], reverse=True
            )[: args.top]
        ],
    )

    predicate = (
        'process == "launchservicesd" OR process == "lsd" OR '
        'process == "runningboardd" OR process == "syspolicyd" OR '
        'eventMessage CONTAINS[c] "LSOpen" OR eventMessage CONTAINS[c] "spawn"'
    )
    code, out, _err, timed_out, duration_ms = run_command(
        [
            "/usr/bin/log",
            "show",
            "--last",
            "5m",
            "--style",
            "compact",
            "--predicate",
            predicate,
        ],
        timeout=args.log_timeout,
    )
    store.emit(
        snapshot_id,
        "evidence_log_excerpt",
        exit=code,
        timeout=timed_out,
        duration_ms=round(duration_ms, 1),
        lines=out.splitlines()[-args.log_lines :],
    )


def evidence_due(store: Store, cooldown_minutes: int) -> bool:
    last = parse_iso(store.get_state("last_evidence_at") or "")
    now = dt.datetime.now(dt.timezone.utc)
    if last is not None and now - last < dt.timedelta(minutes=cooldown_minutes):
        return False
    store.set_state("last_evidence_at", utc_now())
    return True


def load_alert(store: Store, name: str) -> dict[str, Any]:
    alert: dict[str, Any] = {
        "status": "ok",
        "bad_streak": 0,
        "ok_streak": 0,
        "since": "",
        "notified": False,
        "last_attempt_at": "",
        "value": "",
        "detail": "",
    }
    try:
        stored = json.loads(store.get_state(f"alert:{name}") or "{}")
    except json.JSONDecodeError:
        stored = {}
    if isinstance(stored, dict):
        alert.update({key: stored[key] for key in alert if key in stored})
    return alert


def alert_payload(
    name: str, alert: dict[str, Any], args: argparse.Namespace, *, resolved: bool
) -> dict[str, Any]:
    spec = CONDITIONS[name]
    host = socket.gethostname()
    if resolved:
        payload = {
            "title": f"{host}：已恢复：{spec['title']}",
            "message": f"自 {alert['since']} 开始的异常已连续 {spec['resolve_after']} 次检查正常。",
            "interruption_level": "passive",
        }
    else:
        payload = {
            "title": f"{host}：{spec['title']}",
            "message": (
                f"{alert['detail']}（连续 {alert['bad_streak']} 次检查）。"
                "先保存现场：macos-session-health incident --hours 1 --format markdown"
            ),
            "interruption_level": args.brrr_interruption_level,
        }
    payload["subtitle"] = "macOS session health"
    payload["thread_id"] = args.brrr_thread_id
    if args.brrr_open_url:
        payload["open_url"] = args.brrr_open_url
    return payload


def send_alert(
    store: Store,
    snapshot_id: str,
    args: argparse.Namespace,
    name: str,
    alert: dict[str, Any],
    *,
    resolved: bool,
) -> bool:
    payload = alert_payload(name, alert, args, resolved=resolved)
    delivery = deliver_brrr(payload, args.brrr_timeout)
    sent = delivery["exit"] == 0 and not delivery.get("timeout", False)
    store.emit(
        snapshot_id,
        "brrr_notification",
        None if sent else "warning",
        condition=name,
        transition="resolved" if resolved else "fired",
        title=payload["title"],
        interruption_level=payload["interruption_level"],
        sent=sent,
        exit=delivery["exit"],
        timeout=delivery.get("timeout", False),
        duration_ms=delivery.get("duration_ms", 0),
        http_status=delivery.get("http_status", ""),
        auth_mode=delivery["auth_mode"],
        credential_source=delivery["credential_source"],
        endpoint=delivery.get("endpoint", ""),
        error=delivery.get("error", ""),
    )
    return sent


def update_alerts(
    store: Store,
    snapshot_id: str,
    observations: dict[str, dict[str, Any]],
    args: argparse.Namespace,
) -> None:
    now = dt.datetime.now(dt.timezone.utc)
    for name, observed in observations.items():
        spec = CONDITIONS[name]
        alert = load_alert(store, name)
        if observed["state"] != "ok":
            store.emit(
                snapshot_id,
                "condition",
                condition=name,
                state=observed["state"],
                value=observed["value"],
                detail=observed["detail"],
            )
        if observed["state"] == "bad":
            alert["bad_streak"] += 1
            alert["ok_streak"] = 0
            alert["value"] = observed["value"]
            alert["detail"] = observed["detail"]
        elif observed["state"] == "ok":
            alert["ok_streak"] += 1
            alert["bad_streak"] = 0

        if alert["status"] == "ok" and alert["bad_streak"] >= spec["fire_after"]:
            alert.update(
                status="firing", since=utc_now(), notified=False, last_attempt_at=""
            )
            store.emit(
                snapshot_id,
                "alert",
                "error",
                condition=name,
                transition="fired",
                value=alert["value"],
                detail=alert["detail"],
            )
        elif (
            alert["status"] == "firing" and alert["ok_streak"] >= spec["resolve_after"]
        ):
            store.emit(
                snapshot_id,
                "alert",
                condition=name,
                transition="resolved",
                since=alert["since"],
            )
            if alert["notified"]:
                send_alert(store, snapshot_id, args, name, alert, resolved=True)
            alert.update(status="ok", since="", notified=False, last_attempt_at="")

        if alert["status"] == "firing" and not alert["notified"]:
            last_attempt = parse_iso(alert["last_attempt_at"])
            retry = dt.timedelta(minutes=args.brrr_retry_minutes)
            if last_attempt is None or now - last_attempt >= retry:
                alert["notified"] = send_alert(
                    store, snapshot_id, args, name, alert, resolved=False
                )
                alert["last_attempt_at"] = utc_now()
        store.set_state(f"alert:{name}", json.dumps(alert, ensure_ascii=False))


def collect_observations(
    store: Store, snapshot_id: str, args: argparse.Namespace
) -> tuple[dict[str, dict[str, Any]], list[dict[str, Any]] | None]:
    observations = {
        "spawn_failed": probe_spawn(store, snapshot_id, args.spawn_check_timeout)
    }
    rows = sample_processes(store, snapshot_id, args.command_timeout)
    limits = read_kernel_limits(store, snapshot_id, args.command_timeout)
    observations["process_table_high"] = probe_process_table(
        rows, limits, args.process_table_warn_pct
    )
    observations["file_table_high"] = probe_file_table(limits, args.file_table_warn_pct)
    observations["syspolicyd_rss_high"] = probe_syspolicyd_rss(
        store, snapshot_id, rows, args.syspolicyd_rss_limit_mb
    )
    if should_run_periodic(
        store, "syspolicyd_log", args.syspolicyd_log_interval_minutes
    ):
        observations["syspolicyd_log_errors"] = probe_syspolicyd_log(
            store,
            snapshot_id,
            timeout=args.log_timeout,
            last_minutes=args.syspolicyd_log_interval_minutes,
            assessment_failure_limit=args.syspolicyd_assessment_failure_limit,
            max_lines=args.syspolicyd_log_lines,
        )
    return observations, rows


def snapshot(args: argparse.Namespace, store: Store, mode: str) -> str:
    snapshot_id = store.create_snapshot(mode)
    status = "ok"
    store.emit(snapshot_id, "snapshot_begin", sid=snapshot_id, mode=mode)
    try:
        deleted = store.prune(args.retention_days)
        if deleted:
            store.emit(
                snapshot_id,
                "retention_prune",
                retention_days=args.retention_days,
                deleted_snapshots=deleted,
            )
        observations, rows = collect_observations(store, snapshot_id, args)
        if any(observed["state"] == "bad" for observed in observations.values()):
            status = "unhealthy"
            if args.collect_evidence and evidence_due(
                store, args.evidence_cooldown_minutes
            ):
                collect_evidence(store, snapshot_id, rows, args)
        observations["collector_failing"] = observation("ok")
        update_alerts(store, snapshot_id, observations, args)
        store.emit(snapshot_id, "snapshot_end", sid=snapshot_id, status=status)
    except Exception as exc:
        status = "error"
        detail = f"{type(exc).__name__}: {exc}"
        try:
            store.emit(snapshot_id, "collector_exception", "critical", error=detail)
            update_alerts(
                store,
                snapshot_id,
                {"collector_failing": observation("bad", 1, f"采集器异常：{detail}")},
                args,
            )
        except Exception:
            pass
        try:
            store.emit(snapshot_id, "snapshot_end", sid=snapshot_id, status=status)
        except Exception:
            pass
        raise
    finally:
        try:
            store.finish_snapshot(snapshot_id, status)
        except Exception:
            # Never mask the collector exception that is already propagating.
            if status != "error":
                raise
    return status


def read_brrr_secret_from_file(env_file: Path) -> str:
    try:
        lines = env_file.read_text().splitlines()
    except OSError:
        return ""
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            fields = shlex.split(line, comments=True, posix=True)
        except ValueError:
            continue
        if fields and fields[0] == "export":
            # shell-idiomatic `export KEY=value` form equally valid here.
            fields = fields[1:]
        if len(fields) != 1 or "=" not in fields[0]:
            continue
        key, value = fields[0].split("=", 1)
        if key == "BRRR_SECRET" and value:
            return value
    return ""


def brrr_configuration(*, include_environment: bool = True) -> dict[str, Any]:
    secret = os.getenv("BRRR_SECRET", "") if include_environment else ""
    source = "environment" if secret else ""
    candidates = list(BRRR_ENV_FILES)
    explicit_env_file = os.getenv("BRRR_ENV_FILE", "") if include_environment else ""
    if explicit_env_file:
        candidates.insert(0, Path(explicit_env_file).expanduser())
    if not secret:
        for env_file in candidates:
            secret = read_brrr_secret_from_file(env_file)
            if secret:
                source = str(env_file)
                break

    if secret:
        return {
            "configured": True,
            "auth_mode": "bearer",
            "endpoint": "https://api.brrr.now/v1/send",
            "credential_source": source,
            "secret": secret,
        }
    if Path("/exe.dev/shelley.json").is_file():
        return {
            "configured": True,
            "auth_mode": "exe.dev-proxy",
            "endpoint": "https://brrr.int.exe.xyz/v1/send",
            "credential_source": "exe.dev-proxy",
            "secret": "",
        }

    return {
        "configured": False,
        "auth_mode": "unconfigured",
        "endpoint": "",
        "credential_source": "",
        "secret": "",
    }


def deliver_brrr(
    payload: dict[str, Any],
    timeout: float,
    *,
    dry_run: bool = False,
) -> dict[str, Any]:
    config = brrr_configuration()
    public_config = {key: value for key, value in config.items() if key != "secret"}
    if dry_run:
        return {
            **public_config,
            "exit": 0 if config["configured"] else 3,
            "payload": payload,
        }
    if not config["configured"]:
        return {
            **public_config,
            "exit": 3,
            "timeout": False,
            "error": "brrr is not configured",
        }

    body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode(
        "utf-8"
    )
    headers = {"Content-Type": "application/json", "User-Agent": "macos-session-health"}
    if config["auth_mode"] == "bearer":
        headers["Authorization"] = f"Bearer {config['secret']}"

    started = time.monotonic()
    request = urllib.request.Request(
        str(config["endpoint"]), data=body, headers=headers, method="POST"
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status_code = int(response.status)
        return {
            **public_config,
            "exit": 0 if 200 <= status_code < 300 else 1,
            "http_status": status_code,
            "timeout": False,
            "duration_ms": round((time.monotonic() - started) * 1000, 1),
        }
    except urllib.error.HTTPError as exc:
        last_error = f"HTTP {exc.code}"
        timed_out = False
        http_status: int | str = exc.code
    except (TimeoutError, urllib.error.URLError) as exc:
        timed_out = isinstance(exc, TimeoutError) or isinstance(
            getattr(exc, "reason", None), TimeoutError
        )
        last_error = str(exc.reason if isinstance(exc, urllib.error.URLError) else exc)
        http_status = ""
    return {
        **public_config,
        "exit": 1,
        "timeout": timed_out,
        "duration_ms": round((time.monotonic() - started) * 1000, 1),
        "http_status": http_status,
        "error": last_error,
    }


def fetch_event_names(conn: sqlite3.Connection) -> set[str]:
    try:
        rows = conn.execute(
            "SELECT DISTINCT event FROM events ORDER BY event"
        ).fetchall()
    except sqlite3.Error as exc:
        raise CliError("unable to read events") from exc
    return {str(row[0]) for row in rows}


def event_record(row: sqlite3.Row) -> dict[str, Any]:
    record = {
        "ts": row["ts"],
        "event": row["event"],
        "severity": row["severity"] or "",
        "snapshot_status": row["status"] or "",
        "snapshot_id": row["snapshot_id"],
    }
    record.update(json.loads(row["data_json"]))
    return record


def query(
    db_path: Path,
    limit: int,
    event: str | None,
    output_format: str,
) -> int:
    conn = open_read_db(db_path)
    available_events = fetch_event_names(conn)
    if event and event not in KNOWN_EVENTS and event not in available_events:
        known = sorted(KNOWN_EVENTS | available_events)
        raise CliError(f"unknown event: {event}. Known events: {', '.join(known)}")
    where_sql = "WHERE e.event = ?" if event else ""
    params: list[Any] = [event] if event else []
    try:
        rows = conn.execute(
            f"""
            SELECT e.ts, e.event, e.severity, e.data_json, s.status, s.id AS snapshot_id
            FROM events e
            JOIN snapshots s ON s.id = e.snapshot_id
            {where_sql}
            ORDER BY e.id DESC
            LIMIT ?
            """,
            (*params, limit),
        ).fetchall()
    except sqlite3.Error as exc:
        raise CliError("unable to query events") from exc
    finally:
        conn.close()
    print_records([event_record(row) for row in rows], output_format)
    return 0


def events(db_path: Path, output_format: str) -> int:
    conn = open_read_db(db_path)
    try:
        event_names = fetch_event_names(conn)
    finally:
        conn.close()
    print_records([{"event": event} for event in sorted(event_names)], output_format)
    return 0


def load_events(
    conn: sqlite3.Connection, *, event: str, cutoff: str, limit: int
) -> list[dict[str, Any]]:
    rows = conn.execute(
        """
        SELECT e.ts, e.event, e.severity, e.data_json, s.status, s.id AS snapshot_id
        FROM events e
        JOIN snapshots s ON s.id = e.snapshot_id
        WHERE e.event = ? AND e.ts >= ?
        ORDER BY e.id DESC
        LIMIT ?
        """,
        (event, cutoff, limit),
    ).fetchall()
    return [event_record(row) for row in rows]


def compact_record(record: dict[str, Any], keys: list[str]) -> str:
    return " ".join(
        f"{key}={record[key]}" for key in keys if record.get(key) not in (None, "")
    )


def render_incident_markdown(report: dict[str, Any]) -> str:
    summary = report["snapshot_summary"]
    lines = [
        "# macos-session-health Incident Report",
        "",
        f"- generated_at: `{report['generated_at']}`",
        f"- db: `{report['db']}`",
        f"- window_hours: `{report['window_hours']}`",
        f"- newest_snapshot: `{summary['newest'] or 'none'}`",
        f"- snapshots: total `{summary['total']}`, unhealthy `{summary['unhealthy']}`, error `{summary['error']}`",
        "- runbook: `services/macos-session-health/README.md`",
        "",
        "## Conditions",
        "",
        "| condition | status | since | bad samples | last bad | latest detail |",
        "| --- | --- | --- | ---: | --- | --- |",
    ]
    for row in report["conditions"]:
        lines.append(
            "| {condition} | {status} | {since} | {bad_samples} | {last_bad} | {detail} |".format(
                **row
            )
        )

    sections: list[tuple[str, str, list[str]]] = [
        (
            "Alerts and Notifications",
            "notifications",
            ["condition", "transition", "sent", "error", "detail"],
        ),
        ("Collector Exceptions", "collector_exceptions", ["error"]),
        (
            "Failed Spawn Checks",
            "failed_spawn_checks",
            ["name", "exit", "timeout", "duration_ms", "stderr"],
        ),
        (
            "syspolicyd Resources",
            "syspolicyd_resources",
            ["pid", "rss_mb", "cpu_percent", "etime", "stat"],
        ),
        (
            "syspolicyd Log Scans",
            "syspolicyd_log_scans",
            ["fd_exhausted", "assessment_failed", "duration_ms", "timeout", "exit"],
        ),
        ("syspolicyd Log Matches", "syspolicyd_log_matches", ["category", "line"]),
    ]
    for title, key, fields in sections:
        lines.extend(["", f"## {title}", ""])
        records = report[key]
        for record in records:
            lines.append(f"- `{record['ts']}` " + compact_record(record, fields))
        if not records:
            lines.append("No records in window.")

    evidence = report["latest_evidence"]
    lines.extend(["", "## Latest Evidence", ""])
    if not evidence:
        lines.append(
            "No evidence was collected in window; evidence is recorded only while a condition is bad."
        )
    context = evidence.get("system_context")
    if context:
        lines.append(
            f"- `{context['ts']}` system "
            + compact_record(
                context, ["loadavg_1", "loadavg_5", "loadavg_15", "boottime"]
            )
        )
    for row in evidence.get("cpu_top", []):
        lines.append(
            "- cpu "
            + compact_record(row, ["cpu_percent", "pid", "ppid", "rss_mb", "comm"])
        )
    counts = evidence.get("process_counts") or {}
    for row in counts.get("by_command", []):
        lines.append("- processes " + compact_record(row, ["count", "comm"]))
    for row in counts.get("by_parent", []):
        lines.append(
            "- children " + compact_record(row, ["count", "ppid", "parent_comm"])
        )
    for row in counts.get("zombies", []):
        lines.append("- zombie " + compact_record(row, ["pid", "ppid", "parent_comm"]))
    for row in evidence.get("fd_top", []):
        lines.append("- fds " + compact_record(row, ["count", "pid", "comm"]))
    for line in evidence.get("log_excerpt", []):
        lines.append(f"- log {line}")
    lines.append("")
    return "\n".join(lines)


def incident_report(db_path: Path, hours: float, limit: int, output_format: str) -> int:
    cutoff = (
        (dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=hours))
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z")
    )
    conn = open_read_db(db_path)
    try:
        summary_row = conn.execute(
            """
            SELECT
              count(*) AS total,
              sum(status = 'unhealthy') AS unhealthy,
              sum(status = 'error') AS error,
              max(coalesce(ended_at, started_at)) AS newest
            FROM snapshots
            WHERE started_at >= ?
            """,
            (cutoff,),
        ).fetchone()
        condition_rows = {
            row["condition"]: row
            for row in conn.execute(
                """
                SELECT
                  json_extract(data_json, '$.condition') AS condition,
                  count(*) AS bad_samples,
                  max(ts) AS last_bad
                FROM events
                WHERE event = 'condition' AND ts >= ?
                  AND json_extract(data_json, '$.state') = 'bad'
                GROUP BY condition
                """,
                (cutoff,),
            ).fetchall()
        }
        alert_states: dict[str, dict[str, Any]] = {}
        for row in conn.execute(
            "SELECT key, value FROM state WHERE key LIKE 'alert:%'"
        ).fetchall():
            try:
                alert_states[str(row["key"])[len("alert:") :]] = json.loads(
                    row["value"]
                )
            except json.JSONDecodeError:
                continue
        notifications = [
            *load_events(conn, event="alert", cutoff=cutoff, limit=limit),
            *load_events(conn, event="brrr_notification", cutoff=cutoff, limit=limit),
        ]
        notifications.sort(key=lambda record: record["ts"], reverse=True)
        spawn_checks = load_events(
            conn, event="spawn_check", cutoff=cutoff, limit=limit * 50
        )
        evidence: dict[str, Any] = {}
        for key, event in (
            ("system_context", "evidence_system_context"),
            ("cpu_top", "evidence_cpu_top"),
            ("process_counts", "evidence_process_counts"),
            ("fd_top", "evidence_fd_top"),
            ("log_excerpt", "evidence_log_excerpt"),
        ):
            records = load_events(conn, event=event, cutoff=cutoff, limit=1)
            if not records:
                continue
            record = records[0]
            if key in ("cpu_top", "fd_top"):
                evidence[key] = record.get("rows", [])
            elif key == "log_excerpt":
                evidence[key] = record.get("lines", [])
            else:
                evidence[key] = record
        report = {
            "generated_at": utc_now(),
            "db": str(db_path),
            "window_hours": hours,
            "snapshot_summary": {
                "total": int(summary_row["total"] or 0),
                "unhealthy": int(summary_row["unhealthy"] or 0),
                "error": int(summary_row["error"] or 0),
                "newest": summary_row["newest"] or "",
            },
            "conditions": [
                {
                    "condition": name,
                    "status": alert_states.get(name, {}).get("status", "ok"),
                    "since": alert_states.get(name, {}).get("since", ""),
                    "bad_samples": int(condition_rows[name]["bad_samples"])
                    if name in condition_rows
                    else 0,
                    "last_bad": condition_rows[name]["last_bad"]
                    if name in condition_rows
                    else "",
                    "detail": alert_states.get(name, {}).get("detail", ""),
                }
                for name in CONDITIONS
            ],
            "notifications": notifications[:limit],
            "collector_exceptions": load_events(
                conn, event="collector_exception", cutoff=cutoff, limit=limit
            ),
            "failed_spawn_checks": [
                record
                for record in spawn_checks
                if record.get("exit") != 0 or record.get("timeout")
            ][:limit],
            "syspolicyd_resources": load_events(
                conn, event="syspolicyd_resource", cutoff=cutoff, limit=limit
            ),
            "syspolicyd_log_scans": load_events(
                conn, event="syspolicyd_log_scan", cutoff=cutoff, limit=limit
            ),
            "syspolicyd_log_matches": load_events(
                conn, event="syspolicyd_log_match", cutoff=cutoff, limit=limit
            ),
            "latest_evidence": evidence,
        }
    except sqlite3.Error as exc:
        raise CliError("unable to build incident report") from exc
    finally:
        conn.close()

    if output_format == "json":
        print(json.dumps(report, ensure_ascii=False))
    else:
        print(render_incident_markdown(report))
    return 0


def env_int(name: str, default: int) -> int:
    return int(os.getenv(f"MACOS_SESSION_HEALTH_{name}", str(default)))


def env_float(name: str, default: float) -> float:
    return float(os.getenv(f"MACOS_SESSION_HEALTH_{name}", str(default)))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="macos-session-health",
        description="Watch for macOS session symptoms and notify only when one persists.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  macos-session-health incident --hours 6 --format markdown
  macos-session-health query --event condition --limit 20
  macos-session-health events --format json

Run `macos-session-health install` to install or refresh the user LaunchAgent.
""",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument(
        "--db",
        type=Path,
        default=DEFAULT_DB,
        help=f"SQLite path. Default: {DEFAULT_DB}",
    )
    parser.add_argument(
        "--no-db", action="store_true", help="Only emit stdout; do not write SQLite."
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        help="Write SQLite without stdout logfmt output.",
    )
    parser.add_argument("--top", type=int, default=env_int("TOP", 15))
    parser.add_argument("--command-timeout", type=float, default=5)
    parser.add_argument(
        "--spawn-check-timeout",
        type=float,
        default=5,
        help="Timeout in seconds for each spawn check command.",
    )
    parser.add_argument(
        "--process-table-warn-pct",
        type=int,
        default=env_int("PROCESS_TABLE_WARN_PCT", 85),
        help="Bad when processes reach this percentage of kern.maxproc or kern.maxprocperuid.",
    )
    parser.add_argument(
        "--file-table-warn-pct",
        type=int,
        default=env_int("FILE_TABLE_WARN_PCT", 80),
        help="Bad when kern.num_files reaches this percentage of kern.maxfiles.",
    )
    parser.add_argument(
        "--syspolicyd-rss-limit-mb",
        type=float,
        default=env_float("SYSPOLICYD_RSS_LIMIT_MB", 1536),
        help="Bad when syspolicyd RSS reaches this many MiB.",
    )
    parser.add_argument(
        "--syspolicyd-log-interval-minutes",
        type=int,
        default=env_int("SYSPOLICYD_LOG_INTERVAL_MINUTES", 5),
        help="Scan this many minutes of syspolicyd log at this interval. Set 0 to disable.",
    )
    parser.add_argument(
        "--syspolicyd-assessment-failure-limit",
        type=int,
        default=env_int("SYSPOLICYD_ASSESSMENT_FAILURE_LIMIT", 100),
        help="Bad when one scan finds this many SecStaticCode failures.",
    )
    parser.add_argument(
        "--syspolicyd-log-lines",
        type=int,
        default=env_int("SYSPOLICYD_LOG_LINES", 20),
        help="Store at most this many matched syspolicyd log lines per scan.",
    )
    parser.add_argument(
        "--log-timeout",
        type=float,
        default=env_float("LOG_TIMEOUT", 30),
        help="Timeout for each `log show` query.",
    )
    parser.add_argument("--log-lines", type=int, default=120)
    parser.add_argument(
        "--lsof-timeout", type=float, default=env_float("LSOF_TIMEOUT", 10)
    )
    parser.add_argument(
        "--collect-evidence", action=argparse.BooleanOptionalAction, default=True
    )
    parser.add_argument(
        "--evidence-cooldown-minutes",
        type=int,
        default=env_int("EVIDENCE_COOLDOWN_MINUTES", 30),
        help="While a condition is bad, collect evidence at most this often.",
    )
    parser.add_argument(
        "--retention-days",
        type=int,
        default=env_int("RETENTION_DAYS", 14),
        help="Delete snapshots older than this many days. Set 0 to disable.",
    )
    parser.add_argument(
        "--brrr-retry-minutes",
        type=int,
        default=env_int("BRRR_RETRY_MINUTES", 10),
        help="Retry a failed alert delivery at most this often while it still fires.",
    )
    parser.add_argument(
        "--brrr-thread-id",
        default=os.getenv(
            "MACOS_SESSION_HEALTH_BRRR_THREAD_ID", "macos-session-health"
        ),
        help="brrr thread_id for grouped notifications.",
    )
    parser.add_argument(
        "--brrr-interruption-level",
        choices=["passive", "active", "time-sensitive", "critical"],
        default=os.getenv("MACOS_SESSION_HEALTH_BRRR_INTERRUPTION_LEVEL", "active"),
        help="brrr interruption level for alerts; recoveries are always passive.",
    )
    parser.add_argument(
        "--brrr-open-url",
        default=os.getenv("MACOS_SESSION_HEALTH_BRRR_OPEN_URL", ""),
        help="Optional brrr open_url.",
    )
    parser.add_argument(
        "--brrr-timeout",
        type=float,
        default=env_float("BRRR_TIMEOUT", 10),
        help="Timeout in seconds for one brrr delivery.",
    )

    subparsers = parser.add_subparsers(dest="command")
    install_parser = subparsers.add_parser(
        "install", help="Preview, or install or refresh the user LaunchAgent."
    )
    install_parser.add_argument(
        "--apply",
        action="store_true",
        help="Install; without it, validate the managed paths and runtime only.",
    )
    uninstall_parser = subparsers.add_parser(
        "uninstall", help="Preview, or unload the LaunchAgent and remove installed files."
    )
    uninstall_parser.add_argument(
        "--apply", action="store_true", help="Remove; without it, list the targets."
    )
    status_parser = subparsers.add_parser(
        "status", help="Show installation, LaunchAgent, and alert state."
    )
    status_parser.add_argument("--format", choices=["logfmt", "json"], default="logfmt")
    notify_test_parser = subparsers.add_parser(
        "notify-test",
        help="Validate or send one notification through the built-in brrr client.",
    )
    notify_test_parser.add_argument(
        "--apply",
        action="store_true",
        help="Send; without it, validate configuration and print the payload.",
    )
    compact_parser = subparsers.add_parser(
        "compact",
        help="Preview, or stop the LaunchAgent, compact its SQLite database, and restart it.",
    )
    compact_parser.add_argument(
        "--format", choices=["logfmt", "json"], default="logfmt"
    )
    compact_parser.add_argument(
        "--apply", action="store_true", help="Compact; without it, report the target."
    )
    subparsers.add_parser(
        "snapshot",
        help="Collect one snapshot.",
        description="Collect one snapshot. Global options before the subcommand control collection behavior.",
    )

    watch = subparsers.add_parser("watch", help="Collect snapshots forever.")
    watch.add_argument("--interval", type=float, default=env_float("INTERVAL", 60))

    query_parser = subparsers.add_parser("query", help="Print recent SQLite events.")
    query_parser.add_argument("--limit", type=int, default=50)
    query_parser.add_argument(
        "--event", help="Event name to filter. Use `events` to list known names."
    )
    query_parser.add_argument("--format", choices=["logfmt", "json"], default="logfmt")

    events_parser = subparsers.add_parser(
        "events", help="List event names present in SQLite."
    )
    events_parser.add_argument("--format", choices=["logfmt", "json"], default="logfmt")

    incident_parser = subparsers.add_parser(
        "incident",
        help="Print a recent incident report from SQLite diagnostics.",
    )
    incident_parser.add_argument("--hours", type=float, default=6)
    incident_parser.add_argument("--limit", type=int, default=20)
    incident_parser.add_argument(
        "--format", choices=["markdown", "json"], default="markdown"
    )

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    args.command = args.command or "snapshot"

    try:
        if args.command == "install":
            return install_launch_agent(apply=args.apply)
        if args.command == "uninstall":
            return uninstall_launch_agent(apply=args.apply)
        if args.command == "status":
            return launch_agent_status(args.format)
        if args.command == "notify-test":
            return test_brrr_notification(args)
        if args.command == "compact":
            return compact_database(args.db, args.format, apply=args.apply)
    except CliError as exc:
        print_error(str(exc))
        return 1

    if args.command in ("query", "events", "incident"):
        if args.no_db:
            parser.error(f"{args.command} requires SQLite; remove --no-db")
        try:
            if args.command == "query":
                return query(args.db, args.limit, args.event, args.format)
            if args.command == "events":
                return events(args.db, args.format)
            return incident_report(args.db, args.hours, args.limit, args.format)
        except CliError as exc:
            print_error(str(exc), db=args.db)
            return 1

    store = Store(None if args.no_db else args.db, emit_stdout=not args.quiet)
    try:
        if args.command == "snapshot":
            status = snapshot(args, store, "snapshot")
            return 0 if status == "ok" else 1
        if args.command == "watch":
            while True:
                snapshot(args, store, "watch")
                time.sleep(args.interval)
        parser.error(f"unknown command: {args.command}")
    finally:
        store.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
