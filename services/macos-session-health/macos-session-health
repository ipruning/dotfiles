class CliError(Exception):
    pass


def utc_now() -> str:
    return (
        dt.datetime
        .now(dt.timezone.utc)
        .isoformat(timespec="seconds")
        .replace("+00:00", "Z")
    )


def logfmt_quote(value: Any) -> str:
    text = "" if value is None else str(value)
    text = text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{text}"'


def print_error(message: str, **data: Any) -> None:
    parts = [f"error={logfmt_quote(message)}"]
    parts.extend(f"{key}={logfmt_quote(value)}" for key, value in data.items())
    print(" ".join(parts), file=sys.stderr)


def print_records(records: list[dict[str, Any]], output_format: str) -> None:
    if output_format == "json":
        print(json.dumps(records, ensure_ascii=False))
        return
    for record in records:
        print(" ".join(f"{key}={logfmt_quote(value)}" for key, value in record.items()))


def launchd_target() -> str:
    return f"gui/{os.getuid()}/{LABEL}"


def launchd_job() -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["launchctl", "print", launchd_target()],
        text=True,
        capture_output=True,
        check=False,
    )


def bootout_launch_agent() -> None:
    if launchd_job().returncode != 0:
        return
    result = subprocess.run(
        ["launchctl", "bootout", launchd_target()],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        detail = (
            result.stderr.strip() or result.stdout.strip() or "launchctl bootout failed"
        )
        raise CliError(detail)
    deadline = time.monotonic() + 3
    while launchd_job().returncode == 0:
        if time.monotonic() >= deadline:
            raise CliError(f"LaunchAgent is still loaded: {launchd_target()}")
        time.sleep(0.1)


def bootstrap_launch_agent() -> None:
    result = subprocess.run(
        ["launchctl", "bootstrap", f"gui/{os.getuid()}", str(LAUNCH_AGENT)],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        detail = (
            result.stderr.strip()
            or result.stdout.strip()
            or "launchctl bootstrap failed"
        )
        raise CliError(detail)
    if launchd_job().returncode != 0:
        raise CliError(f"LaunchAgent did not load: {launchd_target()}")


def runtime_python() -> Path:
    if sys.version_info < (3, 11):
        raise CliError("macos-session-health requires Python 3.11 or newer")
    mise_python = (
        Path.home()
        / ".local"
        / "share"
        / "mise"
        / "installs"
        / "python"
        / "latest"
        / "bin"
        / "python3"
    )
    if mise_python.exists():
        if not mise_python.is_file() or not os.access(mise_python, os.X_OK):
            raise CliError(f"configured mise Python is not executable: {mise_python}")
        try:
            probe = subprocess.run(
                [
                    str(mise_python),
                    "-c",
                    "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')",
                ],
                text=True,
                capture_output=True,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise CliError(
                f"could not validate configured mise Python: {mise_python}: {exc}"
            ) from exc
        if probe.returncode != 0:
            detail = (
                probe.stderr.strip()
                or probe.stdout.strip()
                or f"exit {probe.returncode}"
            )
            raise CliError(
                f"configured mise Python failed validation: {mise_python}: {detail}"
            )
        try:
            major, minor = (int(part) for part in probe.stdout.strip().split(".", 1))
        except (TypeError, ValueError) as exc:
            raise CliError(
                f"configured mise Python returned an invalid version: {probe.stdout.strip()}"
            ) from exc
        if (major, minor) < (3, 11):
            raise CliError(
                f"configured mise Python {major}.{minor} is older than 3.11: {mise_python}"
            )
        return mise_python
    return Path(sys.executable).resolve()


def managed_wrapper() -> bool:
    if not USER_BIN.is_file() or USER_BIN.is_symlink():
        return False
    try:
        first_lines = USER_BIN.read_text().splitlines()[:2]
    except OSError:
        return False
    return WRAPPER_MARKER in first_lines


def legacy_symlink_install() -> bool:
    """Recognize the pre-wrapper layout so it can be migrated in place.

    The previous version symlinked USER_BIN at the repository's own module
    script; that symlink is ours to replace or remove, unlike an arbitrary
    user-placed file. Require both the old path shape and the module's stable
    launchd label so a same-named third-party command is never claimed.
    """
    if not USER_BIN.is_symlink():
        return False
    try:
        target = USER_BIN.resolve()
        if target.name != "macos-session-health" or target.parent.name != (
            "macos-session-health"
        ):
            return False
        content = target.read_text()
    except OSError, UnicodeError:
        return False
    return f'LABEL = "{LABEL}"' in content


def replaceable_install() -> bool:
    return managed_wrapper() or legacy_symlink_install()


def launch_agent_payload(python_bin: Path) -> dict[str, Any]:
    launch_path = ":".join([
        str(Path.home() / ".local" / "share" / "mise" / "shims"),
        str(Path.home() / ".local" / "bin"),
        "/opt/homebrew/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
        "/usr/sbin",
        "/sbin",
    ])
    return {
        "Label": LABEL,
        "ProgramArguments": [
            str(python_bin),
            str(RUNTIME_CLI),
            "--quiet",
            "watch",
            "--interval",
            "60",
        ],
        "RunAtLoad": True,
        "KeepAlive": True,
        "StandardOutPath": str(LOG_DIR / "agent.out.log"),
        "StandardErrorPath": str(LOG_DIR / "agent.err.log"),
        "EnvironmentVariables": {
            "PATH": launch_path,
            "PYTHONUNBUFFERED": "1",
        },
    }


def install_launch_agent(*, apply: bool = False) -> int:
    if sys.platform != "darwin":
        raise CliError("install is supported only on macOS")

    source = Path(__file__).resolve()
    python_bin = runtime_python()
    if USER_BIN.exists() or USER_BIN.is_symlink():
        if not replaceable_install():
            raise CliError(f"refusing to replace unmanaged executable: {USER_BIN}")

    if not apply:
        print_records(
            [
                {
                    "ready": True,
                    "source": str(source),
                    "python": str(python_bin),
                    "executable": str(USER_BIN),
                    "runtime": str(RUNTIME_CLI),
                    "plist": str(LAUNCH_AGENT),
                }
            ],
            "logfmt",
        )
        return 0

    USER_BIN.parent.mkdir(parents=True, exist_ok=True)
    LAUNCH_AGENT.parent.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    DEFAULT_DB.parent.mkdir(parents=True, exist_ok=True)
    bootout_launch_agent()
    completed: list[str] = []
    try:
        runtime_tmp = RUNTIME_CLI.with_name(f".{RUNTIME_CLI.name}.{os.getpid()}.tmp")
        runtime_tmp.write_bytes(source.read_bytes())
        runtime_tmp.chmod(0o755)
        os.replace(runtime_tmp, RUNTIME_CLI)
        completed.append("runtime")

        wrapper_tmp = USER_BIN.with_name(f".{USER_BIN.name}.{os.getpid()}.tmp")
        wrapper_tmp.write_text(
            "#!/bin/sh\n"
            f"{WRAPPER_MARKER}\n"
            f'exec {shlex.quote(str(python_bin))} {shlex.quote(str(RUNTIME_CLI))} "$@"\n'
        )
        wrapper_tmp.chmod(0o755)
        os.replace(wrapper_tmp, USER_BIN)
        completed.append("executable")

        temporary_plist = LAUNCH_AGENT.with_name(
            f".{LAUNCH_AGENT.name}.{os.getpid()}.tmp"
        )
        temporary_plist.write_bytes(
            plistlib.dumps(launch_agent_payload(python_bin), fmt=plistlib.FMT_XML)
        )
        temporary_plist.chmod(0o644)
        os.replace(temporary_plist, LAUNCH_AGENT)
        completed.append("plist")

        bootstrap_launch_agent()
        completed.append("bootstrap")
    except (CliError, OSError) as install_error:
        unload_error = ""
        try:
            bootout_launch_agent()
        except (CliError, OSError) as error:
            unload_error = str(error)
        try:
            loaded = launchd_job().returncode == 0
        except OSError as error:
            loaded = None
            unload_error = unload_error or str(error)
        progress = ",".join(completed) or "none"
        launchd_state = (
            "loaded" if loaded else "unloaded" if loaded is False else "unknown"
        )
        raise CliError(
            f"install failed after completed={progress}; LaunchAgent state={launchd_state}; "
            f"unload_error={unload_error or 'none'}; inspect with `macos-session-health status`, "
            f"then rerun install --apply: {install_error}"
        ) from install_error

    print_records(
        [
            {
                "installed": True,
                "loaded": True,
                "executable": USER_BIN,
                "runtime": RUNTIME_CLI,
                "python": python_bin,
                "plist": LAUNCH_AGENT,
            }
        ],
        "logfmt",
    )
    return 0


def uninstall_launch_agent(*, apply: bool = False) -> int:
    if sys.platform != "darwin":
        raise CliError("uninstall is supported only on macOS")
    if USER_BIN.exists() or USER_BIN.is_symlink():
        if not replaceable_install():
            raise CliError(f"refusing to remove unmanaged executable: {USER_BIN}")
    if not apply:
        print_records(
            [
                {
                    "planned": True,
                    "executable": USER_BIN,
                    "runtime": RUNTIME_CLI,
                    "plist": LAUNCH_AGENT,
                    "state_preserved": DEFAULT_DB.parent,
                }
            ],
            "logfmt",
        )
        return 0
    bootout_launch_agent()
    removed: list[str] = []
    try:
        LAUNCH_AGENT.unlink(missing_ok=True)
        removed.append("plist")
        if replaceable_install():
            USER_BIN.unlink()
        removed.append("executable")
        RUNTIME_CLI.unlink(missing_ok=True)
        removed.append("runtime")
    except OSError as uninstall_error:
        progress = ",".join(removed) or "none"
        raise CliError(
            f"uninstall failed after removed={progress}; LaunchAgent is unloaded; "
            f"rerun uninstall --apply: {uninstall_error}",
        ) from uninstall_error

    print_records(
        [{"installed": False, "loaded": False, "state_preserved": DEFAULT_DB.parent}],
        "logfmt",
    )
    return 0


def runtime_status_health(db_path: Path) -> dict[str, Any]:
    record: dict[str, Any] = {
        "last_snapshot_at": "",
        "last_snapshot_status": "",
        "last_delivery_at": "",
        "last_delivery_sent": None,
        "last_delivery_error": "",
        "firing": [],
    }
    if not db_path.is_file():
        return record
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    except sqlite3.Error:
        return record
    conn.row_factory = sqlite3.Row
    try:
        row = conn.execute(
            "SELECT started_at, ended_at, status FROM snapshots"
            " ORDER BY started_at DESC LIMIT 1"
        ).fetchone()
        if row:
            record["last_snapshot_at"] = row["ended_at"] or row["started_at"]
            record["last_snapshot_status"] = row["status"] or ""
        record.update(latest_brrr_delivery(conn))
        for key, value in conn.execute(
            "SELECT key, value FROM state WHERE key LIKE 'alert:%' ORDER BY key"
        ).fetchall():
            try:
                firing = json.loads(value).get("status") == "firing"
            except AttributeError, json.JSONDecodeError:
                continue
            if firing:
                record["firing"].append(str(key)[len("alert:") :])
    except sqlite3.Error:
        pass
    finally:
        conn.close()
    return record


def latest_brrr_delivery(conn: sqlite3.Connection) -> dict[str, Any]:
    """Return the last recorded delivery facts."""
    try:
        row = conn.execute(
            "SELECT ts, data_json FROM events WHERE event = 'brrr_notification'"
            " ORDER BY ts DESC, id DESC LIMIT 1"
        ).fetchone()
    except sqlite3.Error, json.JSONDecodeError:
        return {}
    if row is None:
        return {}
    try:
        data = json.loads(row[1])
    except json.JSONDecodeError:
        return {}
    return {
        "last_delivery_at": str(row[0]),
        "last_delivery_sent": bool(data.get("sent")),
        "last_delivery_error": str(data.get("error") or ""),
    }


def launch_agent_status(output_format: str) -> int:
    job = launchd_job()
    pid_match = re.search(r"^\s*pid = (\d+)$", job.stdout, re.MULTILINE)
    notification = brrr_configuration(include_environment=False)
    record = {
        "installed": managed_wrapper() and RUNTIME_CLI.is_file(),
        "loaded": job.returncode == 0,
        "pid": int(pid_match.group(1)) if pid_match else None,
        "executable": str(USER_BIN),
        "runtime": str(RUNTIME_CLI),
        "plist": str(LAUNCH_AGENT),
        "notification_configured": notification["configured"],
        "notification_auth_mode": notification["auth_mode"],
        "notification_credential_source": notification["credential_source"],
        **runtime_status_health(DEFAULT_DB),
    }
    print_records([record], output_format)
    return 0 if record["installed"] and record["loaded"] else 1


def compact_database(db_path: Path, output_format: str, *, apply: bool = False) -> int:
    if not db_path.is_file():
        raise CliError(f"database does not exist: {db_path}")
    service_loaded = db_path == DEFAULT_DB and launchd_job().returncode == 0
    before_size = db_path.stat().st_size
    if not apply:
        print_records(
            [
                {
                    "planned": True,
                    "database": str(db_path),
                    "before_bytes": before_size,
                    "service_restart": service_loaded,
                }
            ],
            output_format,
        )
        return 0
    if service_loaded:
        bootout_launch_agent()
    try:
        conn = sqlite3.connect(db_path, timeout=30)
        try:
            conn.execute("DROP INDEX IF EXISTS idx_events_severity_ts")
            conn.commit()
            conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
            conn.execute("VACUUM")
            conn.execute("PRAGMA optimize")
        finally:
            conn.close()
    except sqlite3.Error as exc:
        raise CliError(f"database compaction failed: {exc}") from exc
    finally:
        if service_loaded:
            bootstrap_launch_agent()
    after_size = db_path.stat().st_size
    print_records(
        [
            {
                "compacted": True,
                "database": str(db_path),
                "before_bytes": before_size,
                "after_bytes": after_size,
                "reclaimed_bytes": max(before_size - after_size, 0),
                "service_restarted": service_loaded,
            }
        ],
        output_format,
    )
    return 0


