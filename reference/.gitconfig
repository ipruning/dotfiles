[core]
excludesfile = ~/.gitignore
ignorecase = false
# Hunk is optional on Linux hosts; retain ordinary paging when it is absent.
pager = "sh -c 'if command -v hunk >/dev/null 2>&1; then exec hunk pager; elif command -v less >/dev/null 2>&1; then exec less; else exec cat; fi'"
quotePath = false

[init]
defaultBranch = main

[protocol]
version = 2 # https://blog.github.com/changelog/2018-11-08-git-protocol-v2-support/

[log]
date = iso

[commit]
verbose = true
template = ~/.gitcommit

[push]
default = current # https://git-scm.com/docs/git-config#Documentation/git-config.txt-pushdefault
autoSetupRemote = true

[pull]
rebase = true

[fetch]
recurseSubmodules = true # still requires: git clone --recursive ...

[rebase]
autoStash = true

[merge]
conflictstyle = zdiff3

[rerere]
enabled = true

[diff]
tool = hunk
colorMoved = default
algorithm = histogram
indentHeuristic = true

[difftool]
prompt = false

[difftool "hunk"]
cmd = "if command -v hunk >/dev/null 2>&1; then exec hunk difftool \"$LOCAL\" \"$REMOTE\"; else git --no-pager diff --no-ext-diff --no-index -- \"$LOCAL\" \"$REMOTE\"; exit_code=$?; test \"$exit_code\" -le 1; fi"

[filter "lfs"]
required = true
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process

[gc]
reflogExpire = 200.days.ago
reflogExpireUnreachable = 90.days.ago

[gitbutler]
aiOpenAIKeyOption = bringYourOwn
aiOpenAIModelName = gpt-5-mini
aiModelProvider = openai

[alias]
log-graph = "log --graph --decorate --all --date-order --date='format:%Y-%m-%d %H:%M:%S' --pretty='format:%C(cyan)%h%Creset %C(black bold)%ad%Creset%C(auto)%d %s' -n 42"
log-graphstat = "log --pretty='format:%C(auto)%h%d%n%s%n%C(auto)%C(blue)%an <%ae>%C(reset), %C(auto)%C(dim)%ad%n' --graph --stat"

diff-conflicts = "diff --name-only --diff-filter=U"
diff-unmerged = "!sh -c 'git diff --name-only -z --diff-filter=U | xargs -0 -n1 ${EDITOR:-vi}' -"

blame = "blame -w -C -C -C"

view-it = "!sh -c 'git log -p --follow -- \"$1\"' -"

untracked = "ls-files --others --exclude-standard"
stage = "add -A"
unstage = "reset HEAD --"

pr = "!sh -c 'set -e; if [ $# -ne 2 ]; then \
  echo \"Usage: git pr <number> <branch>\"; exit 2; fi; \
  case \"$1\" in \"\"|*[!0-9]*|0*) echo \"PR number must be a decimal positive integer\"; exit 2;; esac; \
  git fetch origin --prune; \
  git fetch origin \"pull/$1/head:refs/heads/$2\"; \
  git switch -- \"$2\"; \
  git rebase --autostash origin/main' -"

push-it = "!sh -c 'git push --force-with-lease origin HEAD' -"

cc = "!sh -c 'git log --format=format: --name-only | grep -v \"^$\" | sort | uniq -c | sort -rg | head -42'"
stm = "!sh -c 'git status --porcelain | grep \"^ M\" | cut -c 4-'"

[url "https://github.com/"]
insteadOf = git@github.com:

[credential "https://github.com"]
helper =
helper = !gh auth git-credential

[credential "https://gist.github.com"]
helper =
helper = !gh auth git-credential

# Last so private values (identity, signing, per-org includeIf) win any collision.
[include]
path = ~/.private.gitconfig
