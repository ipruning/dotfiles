#!/usr/bin/env bash

set -euo pipefail
if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
  echo 'Usage: p'
  echo 'Print clipboard text using pbpaste, wl-paste, xclip, or getclip.'
  exit 0
fi
if (( $# != 0 )); then
  echo 'p: no arguments accepted; use --help' >&2
  exit 2
fi
if command -v pbpaste >/dev/null 2>&1; then
  exec pbpaste -Prefer txt
elif [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-paste >/dev/null 2>&1; then
  exec wl-paste --no-newline
elif command -v xclip >/dev/null 2>&1; then
  exec xclip -selection clipboard -o
elif command -v wl-paste >/dev/null 2>&1; then
  exec wl-paste --no-newline
elif command -v getclip >/dev/null 2>&1; then
  exec getclip
else
  echo "no clipboard tool found (pbpaste/wl-paste/xclip/getclip)" >&2
  exit 1
fi
