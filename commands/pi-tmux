#!/usr/bin/env bash

set -euo pipefail
if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
  echo 'Usage: pi-tmux'
  echo 'Create or attach to a Pi tmux session for the current directory (requires git, tmux, zsh, pi).'
  exit 0
fi
if (( $# != 0 )); then
  echo 'pi-tmux: no arguments accepted; use --help' >&2
  exit 2
fi

if ! command -v git >/dev/null 2>&1; then
  echo 'pi-tmux: git is required to derive a stable session ID' >&2
  exit 127
fi

# Session name: "<sanitized basename>-<first 8 hex of the path's git blob hash>".
pwd_abs="$(pwd -P)"
base="$(basename "$pwd_abs" | tr -cs '[:alnum:]' '_' | sed 's/^_//; s/_$//')"
hash="$(printf '%s' "$pwd_abs" | git hash-object --stdin | cut -c1-8)"
session="$base-$hash"

tmux has-session -t "$session" 2>/dev/null || \
  tmux new-session -d -s "$session" -n pi -c "$pwd_abs" 'zsh -i -c "pi"' || true

tmux list-windows -t "$session" -F '#W' 2>/dev/null | grep -qx pi || \
  tmux new-window -t "$session" -n pi -c "$pwd_abs" 'zsh -i -c "pi"' || true

if [ -n "${TMUX-}" ]; then
  tmux switch-client -t "$session"
  tmux select-window -t "$session:pi"
else
  tmux select-window -t "$session:pi"
  tmux attach -t "$session"
fi
