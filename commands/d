#!/usr/bin/env bash

set -euo pipefail
if [[ $# -eq 1 && ( $1 == -h || $1 == --help ) ]]; then
  echo 'Usage: d [lazydocker arguments...]'
  echo 'Launch the interactive Docker manager. For delegated options, see lazydocker --help.'
  exit 0
fi
if ! command -v lazydocker >/dev/null 2>&1; then
  echo "lazydocker not found. Preview: mise run mise-sync; apply: mise run mise-sync -- --apply" >&2
  exit 1
fi

exec lazydocker "$@"
